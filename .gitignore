# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local scratch / secrets (never commit the token or the AOSP checkouts)
.work/
*.token
.gh_token

# Editor / OS cruft
*.swp
*~
.DS_Store
Thumbs.db

# Build artefacts (a full AOSP build would emit these; never tracked)
out/
*.img
*.zip
!docs/**

# Extracted proprietary blobs are generated by device/keenplus/u2/extract-files.sh
# at build time and are NOT committed (licensing + size).  Keep the directory
# structure via its README only.
vendor/keenplus/u2/proprietary/
