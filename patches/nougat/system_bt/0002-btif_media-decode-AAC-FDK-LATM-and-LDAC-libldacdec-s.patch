  **
  ** Function         btif_media_task_handle_inc_media
@@ -1570,6 +1758,18 @@ static void btif_media_task_handle_inc_media(tBT_SBC_HDR*p_msg)
         return;
     }
 #endif
+
+    if (btif_media_cb.sink_codec_type == BTIF_SINK_CODEC_AAC)
+    {
+        btif_media_task_handle_inc_aac(p_msg);
+        return;
+    }
+    if (btif_media_cb.sink_codec_type == BTIF_SINK_CODEC_LDAC)
+    {
+        btif_media_task_handle_inc_ldac(p_msg);
+        return;
+    }
+
     APPL_TRACE_DEBUG("%s Number of sbc frames %d, frame_len %d",
                      __func__, num_sbc_frames, sbc_frame_len);
 
@@ -2225,6 +2425,182 @@ static void btif_media_task_aa_handle_clear_track (void)
     BtifAvrcpAudioTrackDelete(btif_media_cb.audio_track);
     btif_media_cb.audio_track = NULL;
 #endif
+    if (btif_media_cb.aac_decoder != NULL)
+    {
+        aacDecoder_Close(btif_media_cb.aac_decoder);
+        btif_media_cb.aac_decoder = NULL;
+    }
+    if (btif_media_cb.ldac_decoder != NULL)
+    {
+        osi_free(btif_media_cb.ldac_decoder);
+        btif_media_cb.ldac_decoder = NULL;
+    }
+    btif_media_cb.sink_codec_type = BTIF_SINK_CODEC_SBC;
+}
