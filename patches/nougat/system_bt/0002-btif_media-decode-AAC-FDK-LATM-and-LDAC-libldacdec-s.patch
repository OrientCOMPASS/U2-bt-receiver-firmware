         APPL_TRACE_DEBUG(" Process Frames + ");
 
@@ -1537,6 +1592,139 @@ static void btif_media_thread_handle_cmd(fixed_queue_t *queue, UNUSED_ATTR void
 }
 
 #if (BTA_AV_SINK_INCLUDED == TRUE)
+/*******************************************************************************
+ **
+ ** Function         btif_sink_write_audio
+ **
+ ** Description      Route decoded PCM to the AudioTrack (or UIPC) output
+ **
+ ** Returns          void
+ **
+ *******************************************************************************/
+static void btif_sink_write_audio(void *p_buf, UINT32 len)
+{
+    if (len == 0)
+        return;
+#ifdef USE_AUDIO_TRACK
+    BtifAvrcpAudioTrackWriteData(btif_media_cb.audio_track, p_buf, (int)len);
+#else
+    UIPC_Send(UIPC_CH_ID_AV_AUDIO, 0, (UINT8 *)p_buf, len);
+#endif
+}
+
+/*******************************************************************************
+ **
+ ** Function         btif_media_task_handle_inc_aac
+ **
+ ** Description      Decode one RTP packet of AAC (LATM, RFC 3016) and write
+ **                  the PCM to the audio output
+ **
+ ** Returns          void
+ **
+ *******************************************************************************/
+static void btif_media_task_handle_inc_aac(tBT_SBC_HDR *p_msg)
+{
+    UCHAR *p_payload = (UCHAR *)(p_msg + 1) + p_msg->offset;
+    UINT buffer_size = p_msg->len;
+    UINT bytes_valid = p_msg->len;
+
+    if (btif_media_cb.aac_decoder == NULL || buffer_size == 0)
+        return;
+
+    while (bytes_valid > 0)
+    {
+        AAC_DECODER_ERROR err = aacDecoder_Fill(btif_media_cb.aac_decoder,
+                                                &p_payload, &buffer_size,
+                                                &bytes_valid);
+        if (err != AAC_DEC_OK)
+        {
+            APPL_TRACE_ERROR("%s aacDecoder_Fill failed: 0x%x", __func__, err);
+            return;
+        }
+
+        while (1)
+        {
+            CStreamInfo *info;
+            UINT32 frame_len;
+
+            err = aacDecoder_DecodeFrame(btif_media_cb.aac_decoder,
+                                         btif_aac_pcm_buf,
+                                         BTIF_AAC_PCM_BUF_SAMPLES,
+                                         0 /* flags */);
+            if (err == AAC_DEC_NOT_ENOUGH_BITS)
+                break;
+            if (err != AAC_DEC_OK)
+            {
+                APPL_TRACE_ERROR("%s aacDecoder_DecodeFrame failed: 0x%x",
+                                 __func__, err);
+                break;
+            }
+
+            info = aacDecoder_GetStreamInfo(btif_media_cb.aac_decoder);
+            if (info == NULL || info->frameSize <= 0 || info->numChannels <= 0)
+                break;
+
+            frame_len = (UINT32)info->frameSize * (UINT32)info->numChannels *
+                        (UINT32)sizeof(btif_aac_pcm_buf[0]);
+            if (frame_len > sizeof(btif_aac_pcm_buf))
+                frame_len = sizeof(btif_aac_pcm_buf);
+            btif_sink_write_audio(btif_aac_pcm_buf, frame_len);
+        }
+    }
+}
+
+/*******************************************************************************
+ **
+ ** Function         btif_media_task_handle_inc_ldac
+ **
+ ** Description      Decode one RTP packet of LDAC: skip the 1-octet media
+ **                  payload header, then decode num_frames LDAC frames
+ **
+ ** Returns          void
+ **
+ *******************************************************************************/
+static void btif_media_task_handle_inc_ldac(tBT_SBC_HDR *p_msg)
+{
+    UINT8 *p_payload = (UINT8 *)(p_msg + 1) + p_msg->offset;
+    int remaining = (int)p_msg->len;
+    int num_frames;
+
+    if (btif_media_cb.ldac_decoder == NULL ||
+        remaining < (A2D_LDAC_MPL_HDR_LEN + 1))
+        return;
+
+    num_frames = p_payload[0] & A2D_LDAC_HDR_NUM_MSK;
+    p_payload += A2D_LDAC_MPL_HDR_LEN;
+    remaining -= A2D_LDAC_MPL_HDR_LEN;
+
+    while (num_frames-- > 0 && remaining > 0)
+    {
+        int bytes_used = 0;
+        int ret = ldacDecode(btif_media_cb.ldac_decoder, p_payload,
+                             btif_ldac_pcm_buf, &bytes_used);
+        int ch, samples;
+
+        if (ret != 0 || bytes_used <= 0 || bytes_used > remaining)
+        {
+            APPL_TRACE_ERROR("%s ldacDecode failed: ret %d used %d rem %d",
+                             __func__, ret, bytes_used, remaining);
+            break;
+        }
+
+        ch = ldacdecGetChannelCount(btif_media_cb.ldac_decoder);
+        samples = btif_media_cb.ldac_decoder->frame.frameSamples;
+        if (ch > 0 && samples > 0 &&
+            samples * ch <= BTIF_LDAC_PCM_BUF_SAMPLES)
+        {
+            btif_sink_write_audio(btif_ldac_pcm_buf,
+                                  (UINT32)(samples * ch * (int)sizeof(int16_t)));
+        }
+
+        p_payload += bytes_used;
+        remaining -= bytes_used;
+    }
+}
+
