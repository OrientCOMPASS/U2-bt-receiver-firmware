@@ -1331,6 +1369,23 @@ static void btif_media_task_avk_handle_timer(UNUSED_ATTR void *context)
             return;
         }
 
+        if (btif_media_cb.sink_codec_type != BTIF_SINK_CODEC_SBC)
+        {
+            /* AAC/LDAC: decode whole packets as they arrive.  The SBC-style
+             * per-frame budget and partial-packet accounting below does not
+             * apply to these codecs. */
+            int drain = fixed_queue_length(btif_media_cb.RxSbcQ);
+            while (drain-- > 0)
+            {
