 #include "btif_avrcp_audio_track.h"
 #endif
 
+#if (BTA_AV_SINK_INCLUDED == TRUE)
+#include "aacdecoder_lib.h"
+#include "a2d_aac.h"
+#include "a2d_ldac.h"
+#include "ldacdec.h"
