+/*******************************************************************************
+ **
+ ** Function         btif_a2dp_aac_get_track_frequency
+ **
+ ** Description      Map a (single-bit) AAC sampling frequency mask to Hz
+ **
+ *******************************************************************************/
+static UINT32 btif_a2dp_aac_get_track_frequency(UINT16 frequency)
+{
+    if (frequency & A2D_AAC_IE_SAMP_FREQ_96000) return 96000;
+    if (frequency & A2D_AAC_IE_SAMP_FREQ_88200) return 88200;
+    if (frequency & A2D_AAC_IE_SAMP_FREQ_64000) return 64000;
+    if (frequency & A2D_AAC_IE_SAMP_FREQ_48000) return 48000;
+    if (frequency & A2D_AAC_IE_SAMP_FREQ_44100) return 44100;
+    if (frequency & A2D_AAC_IE_SAMP_FREQ_32000) return 32000;
+    if (frequency & A2D_AAC_IE_SAMP_FREQ_24000) return 24000;
+    if (frequency & A2D_AAC_IE_SAMP_FREQ_22050) return 22050;
+    if (frequency & A2D_AAC_IE_SAMP_FREQ_16000) return 16000;
+    if (frequency & A2D_AAC_IE_SAMP_FREQ_12000) return 12000;
+    if (frequency & A2D_AAC_IE_SAMP_FREQ_11025) return 11025;
+    if (frequency & A2D_AAC_IE_SAMP_FREQ_8000)  return 8000;
+    return 44100;
+}
+
+/*******************************************************************************
+ **
+ ** Function         btif_a2dp_ldac_get_track_frequency
+ **
+ ** Description      Map a (single-bit) LDAC sampling frequency mask to Hz
+ **
+ *******************************************************************************/
+static UINT32 btif_a2dp_ldac_get_track_frequency(UINT8 frequency)
+{
+    if (frequency & A2D_LDAC_IE_SAMP_FREQ_96000) return 96000;
+    if (frequency & A2D_LDAC_IE_SAMP_FREQ_88200) return 88200;
+    if (frequency & A2D_LDAC_IE_SAMP_FREQ_48000) return 48000;
+    if (frequency & A2D_LDAC_IE_SAMP_FREQ_44100) return 44100;
+    return 44100;
+}
+
+/*******************************************************************************
+ **
+ ** Function         btif_media_task_aa_handle_decoder_reset_aac
+ **
+ ** Description      Configure the sink decode path for AAC (FDK, LATM input)
+ **
+ ** Returns          void
+ **
+ *******************************************************************************/
+static void btif_media_task_aa_handle_decoder_reset_aac(tBTIF_MEDIA_SINK_CFG_UPDATE *p_buf)
+{
+    tA2D_AAC_CIE aac_cie;
+    UINT32 freq;
+    int ch_type;
+
+    if (A2D_ParsAacInfo(&aac_cie, p_buf->codec_info, FALSE) != A2D_SUCCESS)
+    {
+        APPL_TRACE_ERROR("%s A2D_ParsAacInfo failed", __func__);
+        return;
+    }
+
+    freq = btif_a2dp_aac_get_track_frequency(aac_cie.samp_freq);
+    ch_type = (aac_cie.ch_mode == A2D_AAC_IE_CH_MD_MONO) ?
+              AUDIO_CHANNEL_OUT_MONO : AUDIO_CHANNEL_OUT_STEREO;
+
+    btif_media_cb.sample_rate = freq;
+    btif_media_cb.channel_count = (aac_cie.ch_mode == A2D_AAC_IE_CH_MD_MONO) ? 1 : 2;
+    btif_media_cb.rx_flush = FALSE;
+    btif_media_cb.sink_codec_type = BTIF_SINK_CODEC_AAC;
+
+    if (btif_media_cb.aac_decoder != NULL)
+    {
+        aacDecoder_Close(btif_media_cb.aac_decoder);
+        btif_media_cb.aac_decoder = NULL;
+    }
+    /* RFC 3016: AAC over RTP carries LATM (MCP1) payloads */
+    btif_media_cb.aac_decoder = aacDecoder_Open(TT_MP4_LATM_MCP1, 1 /* nrOfLayers */);
+    if (btif_media_cb.aac_decoder == NULL)
+    {
+        APPL_TRACE_ERROR("%s aacDecoder_Open failed", __func__);
+        btif_media_cb.sink_codec_type = BTIF_SINK_CODEC_SBC;
+        return;
+    }
+    APPL_TRACE_DEBUG("%s A2dpSink: AAC freq %d ch_type %d", __func__, freq, ch_type);
+
+#ifdef USE_AUDIO_TRACK
+    btif_media_cb.audio_track = BtifAvrcpAudioTrackCreate((int)freq, ch_type);
+    if (btif_media_cb.audio_track == NULL)
+    {
+        APPL_TRACE_ERROR("%s A2dpSink: Track creation fails!!!", __func__);
+        return;
+    }
+#else
+    UIPC_Open(UIPC_CH_ID_AV_AUDIO, btif_a2dp_data_cb);
+#endif
+
+    btif_media_cb.frames_to_process = 1;
+}
+
+/*******************************************************************************
+ **
+ ** Function         btif_media_task_aa_handle_decoder_reset_ldac
+ **
+ ** Description      Configure the sink decode path for LDAC (libldacdec)
+ **
+ ** Returns          void
+ **
+ *******************************************************************************/
+static void btif_media_task_aa_handle_decoder_reset_ldac(tBTIF_MEDIA_SINK_CFG_UPDATE *p_buf)
+{
+    tA2D_LDAC_CIE ldac_cie;
+    UINT32 freq;
+    int ch_type;
+
+    if (A2D_ParsLdacInfo(&ldac_cie, p_buf->codec_info, FALSE) != A2D_SUCCESS)
+    {
+        APPL_TRACE_ERROR("%s A2D_ParsLdacInfo failed", __func__);
+        return;
+    }
+
+    freq = btif_a2dp_ldac_get_track_frequency(ldac_cie.samp_freq);
+    ch_type = (ldac_cie.ch_mode == A2D_LDAC_IE_CH_MD_MONO) ?
+              AUDIO_CHANNEL_OUT_MONO : AUDIO_CHANNEL_OUT_STEREO;
+
+    btif_media_cb.sample_rate = freq;
+    btif_media_cb.channel_count = (ldac_cie.ch_mode == A2D_LDAC_IE_CH_MD_MONO) ? 1 : 2;
+    btif_media_cb.rx_flush = FALSE;
+    btif_media_cb.sink_codec_type = BTIF_SINK_CODEC_LDAC;
+
+    if (btif_media_cb.ldac_decoder != NULL)
+    {
+        osi_free(btif_media_cb.ldac_decoder);
+        btif_media_cb.ldac_decoder = NULL;
+    }
+    btif_media_cb.ldac_decoder = (ldacdec_t *)osi_malloc(sizeof(ldacdec_t));
+    if (btif_media_cb.ldac_decoder == NULL)
+    {
+        APPL_TRACE_ERROR("%s cannot allocate LDAC decoder", __func__);
+        btif_media_cb.sink_codec_type = BTIF_SINK_CODEC_SBC;
+        return;
+    }
+    if (ldacdecInit(btif_media_cb.ldac_decoder) != 0)
+    {
+        APPL_TRACE_ERROR("%s ldacdecInit failed", __func__);
+        osi_free(btif_media_cb.ldac_decoder);
+        btif_media_cb.ldac_decoder = NULL;
+        btif_media_cb.sink_codec_type = BTIF_SINK_CODEC_SBC;
+        return;
+    }
+    APPL_TRACE_DEBUG("%s A2dpSink: LDAC freq %d ch_type %d", __func__, freq, ch_type);
+
+#ifdef USE_AUDIO_TRACK
+    btif_media_cb.audio_track = BtifAvrcpAudioTrackCreate((int)freq, ch_type);
+    if (btif_media_cb.audio_track == NULL)
+    {
+        APPL_TRACE_ERROR("%s A2dpSink: Track creation fails!!!", __func__);
+        return;
+    }
+#else
+    UIPC_Open(UIPC_CH_ID_AV_AUDIO, btif_a2dp_data_cb);
+#endif
+
+    btif_media_cb.frames_to_process = 1;
 }
 
 /*******************************************************************************
@@ -2250,6 +2626,19 @@ static void btif_media_task_aa_handle_decoder_reset(BT_HDR *p_msg)
             p_buf->codec_info[1], p_buf->codec_info[2], p_buf->codec_info[3],
             p_buf->codec_info[4], p_buf->codec_info[5], p_buf->codec_info[6]);
 
+    /* Dispatch on the configured media codec type (octet 2 of codec info) */
+    if (p_buf->codec_info[2] == A2D_MEDIA_CT_M24)
+    {
+        btif_media_task_aa_handle_decoder_reset_aac(p_buf);
+        return;
+    }
+    if (p_buf->codec_info[2] == A2D_MEDIA_CT_VEND)
+    {
+        btif_media_task_aa_handle_decoder_reset_ldac(p_buf);
+        return;
+    }
+    btif_media_cb.sink_codec_type = BTIF_SINK_CODEC_SBC;
+
     a2d_status = A2D_ParsSbcInfo(&sbc_cie, p_buf->codec_info, FALSE);
     if (a2d_status != A2D_SUCCESS)
     {
@@ -2753,7 +3142,18 @@ UINT8 btif_media_sink_enque_buf(BT_HDR *p_pkt)
                                   p_pkt->len);
     memcpy((UINT8 *)(p_msg + 1), (UINT8 *)(p_pkt + 1) + p_pkt->offset,
            p_pkt->len);
-    p_msg->num_frames_to_be_processed = (*((UINT8 *)(p_pkt + 1) + p_pkt->offset))& 0x0f;
+    if (btif_media_cb.sink_codec_type == BTIF_SINK_CODEC_AAC)
+    {
+        /* LATM payload (RFC 3016) has no media payload header: treat the
+         * whole packet as one unit; decoding drains it completely. */
+        p_msg->num_frames_to_be_processed = 1;
+    }
+    else
+    {
+        /* SBC and LDAC media payload headers keep the frame count in the
+         * low nibble of the first payload octet */
+        p_msg->num_frames_to_be_processed = (*((UINT8 *)(p_pkt + 1) + p_pkt->offset))& 0x0f;
+    }
     p_msg->len = p_pkt->len;
     p_msg->offset = 0;
     p_msg->layer_specific = p_pkt->layer_specific;
