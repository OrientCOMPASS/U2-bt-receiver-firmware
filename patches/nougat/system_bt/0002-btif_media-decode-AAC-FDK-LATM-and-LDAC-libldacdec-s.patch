+/* Active sink codec, set at stream (re)configuration time */
+#define BTIF_SINK_CODEC_SBC   0
+#define BTIF_SINK_CODEC_AAC   1
+#define BTIF_SINK_CODEC_LDAC  2
+
+/* Decoded-PCM scratch buffers:
+ *   AAC : 1024 samples/frame * 2 ch (+ margin for 960/2048-length frames)
+ *   LDAC: MAX_FRAME_SAMPLES(256) * 2 ch */
+#define BTIF_AAC_PCM_BUF_SAMPLES  4096
+#define BTIF_LDAC_PCM_BUF_SAMPLES 512
+static INT_PCM btif_aac_pcm_buf[BTIF_AAC_PCM_BUF_SAMPLES];
+static int16_t btif_ldac_pcm_buf[BTIF_LDAC_PCM_BUF_SAMPLES];
 #endif
 
