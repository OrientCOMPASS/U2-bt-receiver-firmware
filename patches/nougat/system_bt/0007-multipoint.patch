diff --git a/btif/src/btif_av.c b/btif/src/btif_av.c
index 4d2c985..3aa614a 100644
--- a/btif/src/btif_av.c
+++ b/btif/src/btif_av.c
@@ -94,7 +94,134 @@ typedef struct
 ******************************************************************************/
 static btav_callbacks_t *bt_av_src_callbacks = NULL;
 static btav_callbacks_t *bt_av_sink_callbacks = NULL;
-static btif_av_cb_t btif_av_cb = {0, {{0}}, 0, 0, 0, 0};
+
+/*****************************************************************************
+**  Multipoint (一拖二) support
+**
+**  Two independent A/V slots.  Slot 0 is the "primary" device: it is the one
+**  reported to the Java framework and the one driven by the HAL API calls
+**  (connect/disconnect/start/stop).  Slot 1 is a native-only shadow slot for
+**  the second peer; its state machine runs exactly like slot 0's but its
+**  connection/audio state reports and its AVRCP/meta events are dropped so
+**  the (single-peer) Java A2dpSink state machine is not confused.
+**
+**  Audio ownership is tracked by audio_active_slot: the slot whose decoded
+**  audio currently feeds the single media task AudioTrack.  Mirrors
+**  bta_av_cb.p_active_scb in the BTA layer (which gates the media packets).
+*****************************************************************************/
+#define BTIF_AV_NUM_SLOTS 2
+static btif_av_cb_t btif_av_cb_storage[BTIF_AV_NUM_SLOTS];
+static btif_av_cb_t *g_ctx = &btif_av_cb_storage[0];   /* active context   */
+static int g_ctx_index = 0;                            /* index of g_ctx   */
+#define btif_av_cb (*g_ctx)
+
+static int      audio_active_slot = -1;                /* slot owning audio */
+static BOOLEAN  g_slot_cfg_valid[BTIF_AV_NUM_SLOTS];   /* stored codec cfg  */
+static UINT8    g_slot_cfg[BTIF_AV_NUM_SLOTS][AVDT_CODEC_SIZE];
+static UINT8    g_slot_rc_handle[BTIF_AV_NUM_SLOTS];   /* for meta routing  */
+static int      g_register_next = 0;                   /* REGISTER routing  */
+
+static int btif_av_self_slot(void) { return g_ctx_index; }
+
+static int btif_av_slot_by_hndl(UINT16 hndl)
+{
+    int i;
+    if (hndl == 0) return -1;
+    for (i = 0; i < BTIF_AV_NUM_SLOTS; i++)
+        if (btif_av_cb_storage[i].bta_handle == hndl)
+            return i;
+    return -1;
+}
+
+static int btif_av_slot_by_bda(const bt_bdaddr_t *bda)
+{
+    int i;
+    if (bda == NULL) return -1;
+    for (i = 0; i < BTIF_AV_NUM_SLOTS; i++)
+    {
+        if (btif_av_cb_storage[i].sm_handle == NULL)
+            continue;
+        if (btif_sm_get_state(btif_av_cb_storage[i].sm_handle) == BTIF_AV_STATE_IDLE)
+            continue;
+        if (memcmp(&btif_av_cb_storage[i].peer_bda, bda, sizeof(bt_bdaddr_t)) == 0)
+            return i;
+    }
+    return -1;
+}
+
+static int btif_av_slot_by_rc_handle(UINT8 rc_handle)
+{
+    int i;
+    for (i = 0; i < BTIF_AV_NUM_SLOTS; i++)
+        if (g_slot_rc_handle[i] != 0 && g_slot_rc_handle[i] == (UINT8)(rc_handle + 1))
+            return i;
+    return -1;
+}
+
+static int btif_av_first_free_slot(void)
+{
+    int i;
+    for (i = 0; i < BTIF_AV_NUM_SLOTS; i++)
+    {
+        if (btif_av_cb_storage[i].sm_handle == NULL)
+            continue;
+        if (btif_sm_get_state(btif_av_cb_storage[i].sm_handle) == BTIF_AV_STATE_IDLE)
+            return i;
+    }
+    return -1;
+}
+
+/* Switch the shared media task (decoder + AudioTrack) to the codec config
+ * stored for |slot|.  Used when a second peer starts playing or when the
+ * active peer stops/suspends and the other one is still streaming. */
+static void btif_av_media_switch_to_slot(int slot)
+{
+    if (slot < 0 || slot >= BTIF_AV_NUM_SLOTS)
+        return;
+    BTIF_TRACE_EVENT("MP: media switch to slot %d (was %d)", slot, audio_active_slot);
+    /* claim ownership first so it always matches bta_av_cb.p_active_scb */
+    audio_active_slot = slot;
+    if (!g_slot_cfg_valid[slot])
+    {
+        BTIF_TRACE_WARNING("%s: no stored cfg for slot %d", __func__, slot);
+        return;
+    }
+    /* tear down the old decoder/AudioTrack first (reset_decoder would leak
+     * the previous track), then rebuild from the new peer's codec config */
+    btif_media_task_clear_track();
+    btif_reset_decoder(g_slot_cfg[slot]);
+    btif_a2dp_set_rx_flush(FALSE);
+}
+
+/* Called when the slot owning the audio stops/suspends/closes: try to fall
+ * back to the other slot if it is still in STARTED state, otherwise perform
+ * the legacy media stop (rx flush + stop decoding). */
+static void btif_av_media_stop_with_fallback(int slot, BOOLEAN is_close)
+{
+    int other;
+
+    if (audio_active_slot >= 0 && audio_active_slot != slot)
+        return;   /* this slot did not own the audio: leave it alone */
+
+    other = (slot == 0) ? 1 : 0;
+    if (other < BTIF_AV_NUM_SLOTS &&
+        btif_av_cb_storage[other].sm_handle != NULL &&
+        btif_sm_get_state(btif_av_cb_storage[other].sm_handle) == BTIF_AV_STATE_STARTED &&
+        g_slot_cfg_valid[other])
+    {
+        if (is_close)
+            btif_a2dp_on_stopped(NULL);   /* legacy teardown of old peer's path */
+        btif_av_media_switch_to_slot(other);
+        return;
+    }
+
+    audio_active_slot = -1;
+    if (is_close)
+        btif_a2dp_on_stopped(NULL);
+    else
+        btif_a2dp_on_suspended(NULL);
+}
+
 static alarm_t *av_open_on_rc_timer = NULL;
 
 /* both interface and media task needs to be ready to alloc incoming request */
@@ -259,6 +386,13 @@ static void btif_initiate_av_open_timer_timeout(UNUSED_ATTR void *data)
 *******************************************************************************/
 static void btif_report_connection_state(btav_connection_state_t state, bt_bdaddr_t *bd_addr)
 {
+    /* Multipoint: slot 1 is native-only; the Java A2dpSink state machine
+     * tracks a single device, so never report the secondary slot. */
+    if (g_ctx_index >= 1)
+    {
+        BTIF_TRACE_DEBUG("MP: suppress conn state %d for slot %d", state, g_ctx_index);
+        return;
+    }
     if (bt_av_sink_callbacks != NULL) {
         HAL_CBACK(bt_av_sink_callbacks, connection_state_cb, state, bd_addr);
     } else if (bt_av_src_callbacks != NULL) {
@@ -281,6 +415,12 @@ static void btif_report_connection_state(btav_connection_state_t state, bt_bdadd
 *******************************************************************************/
 static void btif_report_audio_state(btav_audio_state_t state, bt_bdaddr_t *bd_addr)
 {
+    /* Multipoint: never report the secondary slot to the framework. */
+    if (g_ctx_index >= 1)
+    {
+        BTIF_TRACE_DEBUG("MP: suppress audio state %d for slot %d", state, g_ctx_index);
+        return;
+    }
     if (bt_av_sink_callbacks != NULL) {
         HAL_CBACK(bt_av_sink_callbacks, audio_state_cb, state, bd_addr);
     } else if (bt_av_src_callbacks != NULL) {
@@ -310,7 +450,20 @@ static BOOLEAN btif_av_state_idle_handler(btif_sm_event_t event, void *p_data)
             memset(&btif_av_cb.peer_bda, 0, sizeof(bt_bdaddr_t));
             btif_av_cb.flags = 0;
             btif_av_cb.edr = 0;
-            btif_a2dp_on_idle();
+            /* Multipoint: release this slot's audio ownership + stored cfg */
+            g_slot_cfg_valid[g_ctx_index] = FALSE;
+            g_slot_rc_handle[g_ctx_index] = 0;
+            if (audio_active_slot == g_ctx_index)
+                audio_active_slot = -1;
+            if (audio_active_slot < 0)
+            {
+                btif_a2dp_on_idle();
+            }
+            else
+            {
+                BTIF_TRACE_EVENT("MP: skip on_idle, slot %d still owns audio",
+                                 audio_active_slot);
+            }
             break;
 
         case BTIF_SM_EXIT_EVT:
@@ -618,7 +771,8 @@ static BOOLEAN btif_av_state_opening_handler(btif_sm_event_t event, void *p_data
             break;
 
         case BTA_AV_CLOSE_EVT:
-            btif_a2dp_on_stopped(NULL);
+            /* avdtp link is closed (opening state) */
+            btif_av_media_stop_with_fallback(g_ctx_index, TRUE);
             btif_report_connection_state(BTAV_CONNECTION_STATE_DISCONNECTED,
                     &(btif_av_cb.peer_bda));
             btif_sm_change_state(btif_av_cb.sm_handle, BTIF_AV_STATE_IDLE);
@@ -675,10 +829,17 @@ static BOOLEAN btif_av_state_closing_handler(btif_sm_event_t event, void *p_data
             }
             if (btif_av_cb.peer_sep == AVDT_TSEP_SRC)
             {
-                btif_a2dp_set_rx_flush(TRUE);
+                /* Multipoint: only stop the shared media path if this slot
+                 * owns it; otherwise the other slot keeps playing */
+                if (audio_active_slot == g_ctx_index || audio_active_slot < 0)
+                {
+                    btif_a2dp_set_rx_flush(TRUE);
+                    audio_active_slot = -1;
+                }
             }
 
-            btif_a2dp_on_stopped(NULL);
+            if (audio_active_slot < 0)
+                btif_a2dp_on_stopped(NULL);
             break;
 
         case BTIF_SM_EXIT_EVT:
@@ -815,7 +976,7 @@ static BOOLEAN btif_av_state_opened_handler(btif_sm_event_t event, void *p_data)
 
         case BTA_AV_CLOSE_EVT:
              /* avdtp link is closed */
-            btif_a2dp_on_stopped(NULL);
+            btif_av_media_stop_with_fallback(g_ctx_index, TRUE);
 
             /* inform the application that we are disconnected */
             btif_report_connection_state(BTAV_CONNECTION_STATE_DISCONNECTED, &(btif_av_cb.peer_bda));
@@ -897,6 +1058,14 @@ static BOOLEAN btif_av_state_started_handler(btif_sm_event_t event, void *p_data
             /* we are again in started state, clear any remote suspend flags */
             btif_av_cb.flags &= ~BTIF_AV_FLAG_REMOTE_SUSPEND;
 
+            /* Multipoint: this slot began streaming.  Hand the shared media
+             * path (decoder + AudioTrack) over to this slot's codec config if
+             * another slot (or none) currently owns it. */
+            if (audio_active_slot != g_ctx_index)
+            {
+                btif_av_media_switch_to_slot(g_ctx_index);
+            }
+
             /**
              * Report to components above that we have entered the streaming
              * stage, this should usually be followed by focus grant.
@@ -941,8 +1110,19 @@ static BOOLEAN btif_av_state_started_handler(btif_sm_event_t event, void *p_data
             }
 
             if (btif_av_cb.peer_sep == AVDT_TSEP_SRC) {
-                btif_a2dp_set_rx_flush(TRUE);
-                btif_a2dp_on_stopped(NULL);
+                /* Multipoint: only stop the shared media path if this slot
+                 * owns it; the other slot may still be streaming */
+                if (audio_active_slot == g_ctx_index || audio_active_slot < 0)
+                {
+                    btif_a2dp_set_rx_flush(TRUE);
+                    btif_a2dp_on_stopped(NULL);
+                    audio_active_slot = -1;
+                }
+                else
+                {
+                    BTIF_TRACE_EVENT("MP: local suspend slot %d, audio owned by slot %d",
+                                     g_ctx_index, audio_active_slot);
+                }
             }
 
             BTA_AvStop(TRUE);
@@ -968,8 +1148,11 @@ static BOOLEAN btif_av_state_started_handler(btif_sm_event_t event, void *p_data
             BTIF_TRACE_EVENT("BTA_AV_SUSPEND_EVT status %d, init %d",
                  p_av->suspend.status, p_av->suspend.initiator);
 
-            /* a2dp suspended, stop media task until resumed */
-            btif_a2dp_on_suspended(&p_av->suspend);
+            /* a2dp suspended, stop media task until resumed.
+             * Multipoint: only touch the shared media path when this slot
+             * owns the audio. */
+            if (audio_active_slot == g_ctx_index || audio_active_slot < 0)
+                btif_a2dp_on_suspended(&p_av->suspend);
 
             /* if not successful, remain in current state */
             if (p_av->suspend.status != BTA_AV_SUCCESS)
@@ -984,6 +1167,11 @@ static BOOLEAN btif_av_state_started_handler(btif_sm_event_t event, void *p_data
                 return FALSE;
