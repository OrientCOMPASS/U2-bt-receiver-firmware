     p_pkt->event = BTA_AV_MEDIA_DATA_EVT;
     p_scb->seps[p_scb->sep_idx].p_app_data_cback(BTA_AV_MEDIA_DATA_EVT, (tBTA_AV_MEDIA*)p_pkt);
     osi_free(p_pkt);  /* a copy of packet had been delivered, we free this buffer */
@@ -1064,6 +1121,7 @@ void bta_av_cleanup(tBTA_AV_SCB *p_scb, tBTA_AV_DATA *p_data)
     /* if de-registering shut everything down */
     msg.hdr.layer_specific  = p_scb->hndl;
     p_scb->started  = FALSE;
+    bta_av_update_active_sink_scb(p_scb);
     p_scb->cong = FALSE;
     p_scb->role = role;
     p_scb->cur_psc_mask = 0;
@@ -1536,6 +1594,7 @@ void bta_av_do_close (tBTA_AV_SCB *p_scb, tBTA_AV_DATA *p_data)
 
     /* close stream */
     p_scb->started = FALSE;
+    bta_av_update_active_sink_scb(p_scb);
 
     /* drop the buffers queued in L2CAP */
     L2CA_FlushChannel (p_scb->l2c_cid, L2CAP_FLUSH_CHANS_ALL);
@@ -2066,6 +2125,10 @@ void bta_av_str_stopped (tBTA_AV_SCB *p_scb, tBTA_AV_DATA *p_data)
     BT_HDR  *p_buf;
     UINT8 policy = HCI_ENABLE_SNIFF_MODE;
 
+    /* Multipoint: this stream is stopping; if it was the active sink stream,
+     * fall back to the other started sink stream (if any). */
+    bta_av_update_active_sink_scb(p_scb);
+
     APPL_TRACE_ERROR("bta_av_str_stopped:audio_open_cnt=%d, p_data %x",
             bta_av_cb.audio_open_cnt, p_data);
 
@@ -2202,6 +2265,7 @@ void bta_av_reconfig (tBTA_AV_SCB *p_scb, tBTA_AV_DATA *p_data)
         {
             bta_av_str_stopped(p_scb, NULL);
             p_scb->started = FALSE;
+            bta_av_update_active_sink_scb(p_scb);
 
             /* drop the buffers queued in L2CAP */
             L2CA_FlushChannel (p_scb->l2c_cid, L2CAP_FLUSH_CHANS_ALL);
@@ -2336,6 +2400,13 @@ void bta_av_start_ok (tBTA_AV_SCB *p_scb, tBTA_AV_DATA *p_data)
     APPL_TRACE_DEBUG("bta_av_start_ok wait:x%x, role:x%x", p_scb->wait, p_scb->role);
 
     p_scb->started = TRUE;
+    /* Multipoint: this sink stream becomes the active (decoded) one */
+    if ((p_scb->chnl == BTA_AV_CHNL_AUDIO) &&
+        (p_scb->seps[p_scb->sep_idx].tsep == AVDT_TSEP_SNK))
+    {
+        bta_av_cb.p_active_scb = p_scb;
+        APPL_TRACE_EVENT("bta_av_start_ok: active sink scb -> hdl %d", p_scb->hndl);
+    }
     if (p_scb->sco_suspend)
     {
         p_scb->sco_suspend = FALSE;
@@ -2645,6 +2716,7 @@ void bta_av_suspend_cfm (tBTA_AV_SCB *p_scb, tBTA_AV_DATA *p_data)
     {
         /* only set started to FALSE when suspend is successful */
         p_scb->started = FALSE;
+        bta_av_update_active_sink_scb(p_scb);
     }
 
     if (p_scb->role & BTA_AV_ROLE_SUSPEND)
@@ -2834,6 +2906,7 @@ void bta_av_suspend_cont (tBTA_AV_SCB *p_scb, tBTA_AV_DATA *p_data)
     tBTA_AV_RECONFIG    evt;
 
     p_scb->started = FALSE;
+    bta_av_update_active_sink_scb(p_scb);
     p_scb->cong    = FALSE;
     if (err_code)
     {
