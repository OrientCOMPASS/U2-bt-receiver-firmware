 stack/Android.mk           |   2 +
 stack/a2dp/a2d_aac.c       | 143 ++++++++++++++
 stack/a2dp/a2d_ldac.c      | 147 +++++++++++++++
 stack/include/a2d_aac.h    | 109 +++++++++++
 stack/include/a2d_api.h    |   1 +
 stack/include/a2d_ldac.h   | 105 +++++++++++
 10 files changed, 875 insertions(+), 42 deletions(-)
