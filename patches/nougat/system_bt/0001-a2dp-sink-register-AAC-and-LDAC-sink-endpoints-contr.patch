+ ******************************************************************************/
+
+/******************************************************************************
+ *
+ *  Interface to the MPEG-2/4 AAC audio codec (A2DP media codec type 0x02).
+ *  Byte layout follows the A2DP specification, section 4.3.2
+ *  ("MPEG-2/4 AAC Codec Information Element").
+ *
+ ******************************************************************************/
+#ifndef A2D_AAC_H
+#define A2D_AAC_H
+
+#include "a2d_api.h"
+
+/*****************************************************************************
+**  Constants
+*****************************************************************************/
+/* Length of the AAC Media Codec Information Element (octets after LOSC). */
+#define A2D_AAC_INFO_LEN        8
+
+/* [Octet 0] Object type */
+#define A2D_AAC_IE_OBJCT_MSK        0xF0
+#define A2D_AAC_IE_OBJCT_MPEG2_LC   0x80    /* MPEG-2 Low Complexity */
+#define A2D_AAC_IE_OBJCT_MPEG4_LC   0x40    /* MPEG-4 Low Complexity */
+#define A2D_AAC_IE_OBJCT_MPEG4_LTP  0x20    /* MPEG-4 Long Term Prediction */
+#define A2D_AAC_IE_OBJCT_MPEG4_SCA  0x10    /* MPEG-4 Scalable */
+
+/* [Octet 1] Sampling frequency, low byte (8000 .. 44100) */
+#define A2D_AAC_IE_SAMP_FREQ_MSK0   0xFF
+#define A2D_AAC_IE_SAMP_FREQ_8000   0x80
+#define A2D_AAC_IE_SAMP_FREQ_11025  0x40
+#define A2D_AAC_IE_SAMP_FREQ_12000  0x20
+#define A2D_AAC_IE_SAMP_FREQ_16000  0x10
+#define A2D_AAC_IE_SAMP_FREQ_22050  0x08
+#define A2D_AAC_IE_SAMP_FREQ_24000  0x04
+#define A2D_AAC_IE_SAMP_FREQ_32000  0x02
+#define A2D_AAC_IE_SAMP_FREQ_44100  0x01
+
+/* [Octet 2], bits 4-7: sampling frequency, high byte (48000 .. 96000).
+ * In tA2D_AAC_CIE.samp_freq these bits live at 8..11. */
+#define A2D_AAC_IE_SAMP_FREQ_MSK1   (0xF0 << 8)
+#define A2D_AAC_IE_SAMP_FREQ_48000  (0x80 << 8)
+#define A2D_AAC_IE_SAMP_FREQ_64000  (0x40 << 8)
+#define A2D_AAC_IE_SAMP_FREQ_88200  (0x20 << 8)
+#define A2D_AAC_IE_SAMP_FREQ_96000  (0x10 << 8)
+
+/* [Octet 2], bits 2-3: channel mode */
+#define A2D_AAC_IE_CH_MD_MSK        0x0C
+#define A2D_AAC_IE_CH_MD_MONO       0x08
+#define A2D_AAC_IE_CH_MD_STEREO     0x04
+
+/* [Octet 3], bit 7: variable bit rate; bits 0-6: bit rate bits 16-22 */
+#define A2D_AAC_IE_VBR_MSK          0x80
+#define A2D_AAC_IE_VBR_ON           0x80
+#define A2D_AAC_IE_VBR_OFF          0x00
+#define A2D_AAC_IE_BITRATE_MSK0     0x7F
+#define A2D_AAC_IE_BITRATE_MSK      0x7FFFFF
+
+/*****************************************************************************
+**  Type definitions
+*****************************************************************************/
+typedef struct
+{
+    UINT8   obj_type;   /* Object type bit mask */
+    UINT16  samp_freq;  /* Sampling frequency bit mask (octet1 | octet2 << 8) */
+    UINT8   ch_mode;    /* Channel mode bit mask */
+    UINT8   vbr;        /* Variable bit rate: 0 or A2D_AAC_IE_VBR_ON */
+    UINT32  bitrate;    /* Bit rate, 23 bits */
+} tA2D_AAC_CIE;
+
+/*****************************************************************************
+**  External Function Declarations
+*****************************************************************************/
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+/* Builds the AAC Media Codec Capability/Configuration byte sequence
+ * beginning from the LOSC octet. */
+extern tA2D_STATUS A2D_BldAacInfo(UINT8 media_type, tA2D_AAC_CIE *p_ie,
+                                  UINT8 *p_result);
+
+/* Parses the AAC Media Codec Capability byte sequence beginning from the
+ * LOSC octet. for_caps == TRUE relaxes the single-bit checks. */
+extern tA2D_STATUS A2D_ParsAacInfo(tA2D_AAC_CIE *p_ie, const UINT8 *p_info,
+                                   BOOLEAN for_caps);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* A2D_AAC_H */
