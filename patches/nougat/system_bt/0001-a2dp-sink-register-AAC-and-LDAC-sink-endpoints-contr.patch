diff --git a/stack/a2dp/a2d_aac.c b/stack/a2dp/a2d_aac.c
new file mode 100644
index 0000000..b55b20d
--- /dev/null
+++ b/stack/a2dp/a2d_aac.c
@@ -0,0 +1,143 @@
+/******************************************************************************
+ *
+ *  Copyright (C) 2026 The KeenPlus U2 Firmware Project Authors
+ *
+ *  Licensed under the Apache License, Version 2.0 (the "License");
+ *  you may not use this file except in compliance with the License.
+ *  You may obtain a copy of the License at:
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ *  Unless required by applicable law or agreed to in writing, software
+ *  distributed under the License is distributed on an "AS IS" BASIS,
+ *  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ *  See the License for the specific language governing permissions and
+ *  limitations under the License.
+ *
+ ******************************************************************************/
+
+/******************************************************************************
+ *
+ *  Functions for the MPEG-2/4 AAC A2DP media codec (capability/config
+ *  element build + parse).  Byte order follows A2DP spec section 4.3.2.
+ *
+ ******************************************************************************/
+
+#include "a2d_int.h"
+#include "a2d_aac.h"
+#include "bt_utils.h"
+
+/******************************************************************************
+**
+** Function         A2D_BldAacInfo
+**
+** Description      This function is called by an application to build
+**                  the AAC Media Codec Capabilities byte sequence
+**                  beginning from the LOSC octet.
+**                  Input Parameters:
+**                      media_type:  Indicates Audio, or Multimedia.
+**
+**                      p_ie:  The AAC Codec Information Element information.
+**
+**                  Output Parameters:
+**                      p_result:  the resulting codec info byte sequence.
+**
+** Returns          A2D_SUCCESS if function execution succeeded.
+**                  Error status code, otherwise.
+******************************************************************************/
+tA2D_STATUS A2D_BldAacInfo(UINT8 media_type, tA2D_AAC_CIE *p_ie, UINT8 *p_result)
+{
+    tA2D_STATUS status;
+
+    if (p_ie == NULL || p_result == NULL ||
+        (p_ie->obj_type & ~A2D_AAC_IE_OBJCT_MSK) ||
+        (p_ie->samp_freq & ~(A2D_AAC_IE_SAMP_FREQ_MSK0 | A2D_AAC_IE_SAMP_FREQ_MSK1)) ||
+        (p_ie->ch_mode & ~A2D_AAC_IE_CH_MD_MSK) ||
+        (p_ie->vbr & ~A2D_AAC_IE_VBR_MSK) ||
+        (p_ie->bitrate > A2D_AAC_IE_BITRATE_MSK))
+    {
+        /* if any unused bit is set */
+        status = A2D_INVALID_PARAMS;
+    }
+    else
+    {
+        status = A2D_SUCCESS;
+        *p_result++ = A2D_AAC_INFO_LEN;
+        *p_result++ = media_type;
+        *p_result++ = A2D_MEDIA_CT_M24;
+
+        /* Media Codec Specific Information Element */
+        *p_result++ = p_ie->obj_type;
+        *p_result++ = (UINT8)(p_ie->samp_freq & 0xFF);
+        *p_result++ = (UINT8)(((p_ie->samp_freq >> 8) & 0xF0) | p_ie->ch_mode);
+        *p_result++ = (UINT8)(p_ie->vbr | ((p_ie->bitrate >> 16) & A2D_AAC_IE_BITRATE_MSK0));
+        *p_result++ = (UINT8)((p_ie->bitrate >> 8) & 0xFF);
+        *p_result   = (UINT8)(p_ie->bitrate & 0xFF);
+    }
+    return status;
+}
+
+/******************************************************************************
+**
+** Function         A2D_ParsAacInfo
+**
+** Description      This function is called by an application to parse
+**                  the AAC Media Codec Capabilities byte sequence
+**                  beginning from the LOSC octet.
+**                  Input Parameters:
+**                      p_info:  the byte sequence to parse.
+**
+**                      for_caps:  TRUE, if the byte sequence is for get
+**                                 capabilities response.
+**
+**                  Output Parameters:
+**                      p_ie:  The AAC Codec Information Element information.
+**
+** Returns          A2D_SUCCESS if function execution succeeded.
+**                  Error status code, otherwise.
+******************************************************************************/
+tA2D_STATUS A2D_ParsAacInfo(tA2D_AAC_CIE *p_ie, const UINT8 *p_info,
+                            BOOLEAN for_caps)
+{
+    tA2D_STATUS status = A2D_SUCCESS;
+    UINT8 losc;
+
+    if (p_ie == NULL || p_info == NULL)
+        return A2D_INVALID_PARAMS;
+
+    losc = *p_info;
+    p_info += 2;
+
+    /* If the function is called for the wrong Media Type or Media Codec Type */
+    if (losc != A2D_AAC_INFO_LEN || *p_info != A2D_MEDIA_CT_M24)
+        return A2D_WRONG_CODEC;
+
+    p_info++;
+    p_ie->obj_type = *p_info++ & A2D_AAC_IE_OBJCT_MSK;
+
+    p_ie->samp_freq = *p_info++;                          /* octet 1: 8k..44.1k */
+    p_ie->samp_freq |= (UINT16)(*p_info & 0xF0) << 8;     /* octet 2 hi: 48k..96k */
+    p_ie->ch_mode = *p_info++ & A2D_AAC_IE_CH_MD_MSK;
+
+    p_ie->vbr = *p_info & A2D_AAC_IE_VBR_MSK;
+    p_ie->bitrate = (UINT32)(*p_info++ & A2D_AAC_IE_BITRATE_MSK0) << 16;
+    p_ie->bitrate |= (UINT32)(*p_info++) << 8;
+    p_ie->bitrate |= *p_info;
+
+    if (for_caps != FALSE)
+        return status;
+
+    /* Configuration: exactly one object type, one sampling frequency and one
+     * channel mode must be selected. */
+    if (A2D_BitsSet(p_ie->obj_type) != A2D_SET_ONE_BIT)
+        status = A2D_BAD_OBJ_TYPE;
+    if (!((A2D_BitsSet((UINT8)(p_ie->samp_freq & 0xFF)) == A2D_SET_ONE_BIT &&
+           A2D_BitsSet((UINT8)((p_ie->samp_freq >> 8) & 0xFF)) == 0) ||
+          (A2D_BitsSet((UINT8)(p_ie->samp_freq & 0xFF)) == 0 &&
+           A2D_BitsSet((UINT8)((p_ie->samp_freq >> 8) & 0xFF)) == A2D_SET_ONE_BIT)))
+        status = A2D_BAD_SAMP_FREQ;
+    if (A2D_BitsSet(p_ie->ch_mode) != A2D_SET_ONE_BIT)
+        status = A2D_BAD_CHANNEL;
+
+    return status;
+}
