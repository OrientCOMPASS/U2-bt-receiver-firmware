diff --git a/bta/av/bta_av_main.c b/bta/av/bta_av_main.c
index 735ee2c..80504d2 100644
--- a/bta/av/bta_av_main.c
+++ b/bta/av/bta_av_main.c
@@ -628,13 +628,11 @@ static void bta_av_api_register(tBTA_AV_DATA *p_data)
             if (profile_initialized == UUID_SERVCLASS_AUDIO_SOURCE)
             {
                 cs.tsep = AVDT_TSEP_SRC;
-                index = 0;
             }
             else if (profile_initialized == UUID_SERVCLASS_AUDIO_SINK)
             {
                 cs.tsep = AVDT_TSEP_SNK;
                 cs.p_data_cback = bta_av_stream_data_cback;
-                index = 1;
             }
 
             /* Initialize Handles to zero */
@@ -645,18 +643,32 @@ static void bta_av_api_register(tBTA_AV_DATA *p_data)
 
             /* keep the configuration in the stream control block */
             memcpy(&p_scb->cfg, &cs.cfg, sizeof(tAVDT_CFG));
-            if ((*bta_av_a2d_cos.init)(&codec_type, cs.cfg.codec_info,
-                &cs.cfg.num_protect, cs.cfg.protect_info, index) == TRUE)
+
+            /* Register one stream endpoint per codec.  The SRC role keeps a
+             * single endpoint at index 0; the SNK role registers its codec
+             * set (SBC, AAC, LDAC) starting at index 1 and stops as soon as
+             * the callout declines an index (init returns FALSE). */
             {
-                if(AVDT_CreateStream(&p_scb->seps[index].av_handle, &cs) == AVDT_SUCCESS)
+                UINT8 index_last = (cs.tsep == AVDT_TSEP_SRC) ? 1 : BTA_AV_MAX_SEPS;
+                for (index = (cs.tsep == AVDT_TSEP_SRC) ? 0 : 1;
+                     index < index_last; index++)
                 {
-                    p_scb->seps[index].codec_type = codec_type;
-                    p_scb->seps[index].tsep = cs.tsep;
-                    if(cs.tsep == AVDT_TSEP_SNK)
-                        p_scb->seps[index].p_app_data_cback = p_data->api_reg.p_app_data_cback;
-                    else
-                        p_scb->seps[index].p_app_data_cback = NULL; /* In case of A2DP SOURCE we don't need a callback to handle media packets */
+                    tAVDT_CS cs_sep = cs;   /* fresh copy per endpoint */
 
+                    if ((*bta_av_a2d_cos.init)(&codec_type, cs_sep.cfg.codec_info,
+                        &cs_sep.cfg.num_protect, cs_sep.cfg.protect_info, index) != TRUE)
+                    {
+                        break;
+                    }
+                    if(AVDT_CreateStream(&p_scb->seps[index].av_handle, &cs_sep) == AVDT_SUCCESS)
+                    {
+                        p_scb->seps[index].codec_type = codec_type;
+                        p_scb->seps[index].tsep = cs_sep.tsep;
+                        if(cs_sep.tsep == AVDT_TSEP_SNK)
+                            p_scb->seps[index].p_app_data_cback = p_data->api_reg.p_app_data_cback;
+                        else
+                            p_scb->seps[index].p_app_data_cback = NULL; /* In case of A2DP SOURCE we don't need a callback to handle media packets */
+                    }
                 }
             }
 
diff --git a/btif/co/bta_av_co.c b/btif/co/bta_av_co.c
index 76c8836..0f38fcd 100644
--- a/btif/co/bta_av_co.c
+++ b/btif/co/bta_av_co.c
@@ -26,6 +26,8 @@
 #include "string.h"
 #include "a2d_api.h"
 #include "a2d_sbc.h"
+#include "a2d_aac.h"
+#include "a2d_ldac.h"
 #include "bta_sys.h"
 #include "bta_av_api.h"
 #include "bta_av_co.h"
@@ -92,6 +94,29 @@ const tA2D_SBC_CIE bta_av_co_sbc_sink_caps =
     A2D_SBC_IE_MIN_BITPOOL /* min_bitpool */
 };
 
+/* AAC (MPEG-2/4 LC) sink capabilities: what our FDK-based decoder accepts. */
+const tA2D_AAC_CIE bta_av_co_aac_sink_caps =
+{
+    (A2D_AAC_IE_OBJCT_MPEG2_LC | A2D_AAC_IE_OBJCT_MPEG4_LC),    /* obj_type */
+    (A2D_AAC_IE_SAMP_FREQ_44100 | A2D_AAC_IE_SAMP_FREQ_48000),  /* samp_freq */
+    (A2D_AAC_IE_CH_MD_MONO | A2D_AAC_IE_CH_MD_STEREO),          /* ch_mode */
+    A2D_AAC_IE_VBR_ON,                                          /* vbr */
+    320000                                                      /* bitrate */
+};
+
+/* Sony LDAC sink capabilities (vendor id 0x012D, codec id 0x00AA).
+ * Decode side is libldacdec; 660 kbps (EQMID SQ) is the design target but
+ * any EQMID the source picks within these caps decodes fine. */
+const tA2D_LDAC_CIE bta_av_co_ldac_sink_caps =
+{
+    A2D_LDAC_VENDOR_ID,
+    A2D_LDAC_CODEC_ID,
+    (A2D_LDAC_IE_SAMP_FREQ_44100 | A2D_LDAC_IE_SAMP_FREQ_48000 |
+     A2D_LDAC_IE_SAMP_FREQ_88200 | A2D_LDAC_IE_SAMP_FREQ_96000),    /* samp_freq */
+    (A2D_LDAC_IE_CH_MD_MONO | A2D_LDAC_IE_CH_MD_DUAL |
+     A2D_LDAC_IE_CH_MD_STEREO)                                      /* ch_mode */
+};
+
 #if !defined(BTIF_AV_SBC_DEFAULT_SAMP_FREQ)
 #define BTIF_AV_SBC_DEFAULT_SAMP_FREQ A2D_SBC_IE_SAMP_FREQ_44
 #endif
@@ -318,6 +343,24 @@ BOOLEAN bta_av_co_audio_init(UINT8 *p_codec_type, UINT8 *p_codec_info, UINT8 *p_
         /* This should not fail because we are using constants for parameters */
         A2D_BldSbcInfo(AVDT_MEDIA_AUDIO, (tA2D_SBC_CIE *) &bta_av_co_sbc_sink_caps, p_codec_info);
 
+        /* Codec is valid */
+        return TRUE;
+
+    case BTIF_SV_AV_AA_AAC_SINK_INDEX:
+        *p_codec_type = A2D_MEDIA_CT_M24;
+
+        /* This should not fail because we are using constants for parameters */
+        A2D_BldAacInfo(AVDT_MEDIA_AUDIO, (tA2D_AAC_CIE *) &bta_av_co_aac_sink_caps, p_codec_info);
+
+        /* Codec is valid */
+        return TRUE;
+
+    case BTIF_SV_AV_AA_LDAC_SINK_INDEX:
+        *p_codec_type = A2D_MEDIA_CT_VEND;
+
+        /* This should not fail because we are using constants for parameters */
+        A2D_BldLdacInfo(AVDT_MEDIA_AUDIO, (tA2D_LDAC_CIE *) &bta_av_co_ldac_sink_caps, p_codec_info);
+
         /* Codec is valid */
         return TRUE;
 #endif
@@ -377,6 +420,192 @@ void bta_av_co_audio_disc_res(tBTA_AV_HNDL hndl, UINT8 num_seps, UINT8 num_snk,
         p_peer->uuid_to_connect = UUID_SERVCLASS_AUDIO_SINK;
 }
 
+/*******************************************************************************
+ **
+ ** Function         bta_av_ldac_caps_is_ldac
+ **
+ ** Description      TRUE if a vendor codec info element (pointing at the LOSC
+ **                  octet) is the Sony LDAC codec (vendor 0x012D / codec 0x00AA)
+ **
+ *******************************************************************************/
+static BOOLEAN bta_av_ldac_caps_is_ldac(const UINT8 *p_codec_info)
+{
+    return (BOOLEAN)(p_codec_info[3] == (UINT8)(A2D_LDAC_VENDOR_ID & 0xFF) &&
+                     p_codec_info[4] == (UINT8)(A2D_LDAC_VENDOR_ID >> 8) &&
+                     p_codec_info[5] == (UINT8)(A2D_LDAC_CODEC_ID & 0xFF) &&
+                     p_codec_info[6] == (UINT8)(A2D_LDAC_CODEC_ID >> 8));
+}
+
+/*******************************************************************************
+ **
+ ** Function         bta_av_aac_cfg_in_cap / bta_av_ldac_cfg_in_cap
+ **
+ ** Description      TRUE if a single (configuration) codec info element fits
+ **                  inside our sink capabilities.
+ **
+ *******************************************************************************/
+static BOOLEAN bta_av_aac_cfg_in_cap(UINT8 *p_cfg, const tA2D_AAC_CIE *p_cap)
+{
+    tA2D_AAC_CIE cfg;
+
+    if (A2D_ParsAacInfo(&cfg, p_cfg, FALSE) != A2D_SUCCESS)
+        return FALSE;
+    if (!(cfg.obj_type & p_cap->obj_type))
+        return FALSE;
+    if ((cfg.samp_freq & p_cap->samp_freq) != cfg.samp_freq)
+        return FALSE;
+    if ((cfg.ch_mode & p_cap->ch_mode) != cfg.ch_mode)
+        return FALSE;
+    if (cfg.vbr && !p_cap->vbr)
+        return FALSE;
+    if (cfg.bitrate > p_cap->bitrate)
+        return FALSE;
+    return TRUE;
+}
+
+static BOOLEAN bta_av_ldac_cfg_in_cap(UINT8 *p_cfg, const tA2D_LDAC_CIE *p_cap)
+{
+    tA2D_LDAC_CIE cfg;
+
+    /* A2D_ParsLdacInfo validates the vendor/codec identifiers as well */
+    if (A2D_ParsLdacInfo(&cfg, p_cfg, FALSE) != A2D_SUCCESS)
+        return FALSE;
+    if ((cfg.samp_freq & p_cap->samp_freq) != cfg.samp_freq)
+        return FALSE;
+    if ((cfg.ch_mode & p_cap->ch_mode) != cfg.ch_mode)
+        return FALSE;
+    return TRUE;
+}
+
+/*******************************************************************************
+ **
+ ** Function         bta_av_aac_caps_compatible / bta_av_ldac_caps_compatible
+ **
+ ** Description      TRUE if the peer SRC capabilities intersect our SINK
+ **                  capabilities (used for INT-side codec selection).
+ **
+ *******************************************************************************/
+static BOOLEAN bta_av_aac_caps_compatible(UINT8 *p_peer_caps, const tA2D_AAC_CIE *p_cap)
+{
+    tA2D_AAC_CIE peer;
+
+    if (A2D_ParsAacInfo(&peer, p_peer_caps, TRUE) != A2D_SUCCESS)
+        return FALSE;
+    return (BOOLEAN)((peer.obj_type & p_cap->obj_type) &&
+                     (peer.samp_freq & p_cap->samp_freq) &&
+                     (peer.ch_mode & p_cap->ch_mode));
+}
+
+static BOOLEAN bta_av_ldac_caps_compatible(UINT8 *p_peer_caps, const tA2D_LDAC_CIE *p_cap)
+{
+    tA2D_LDAC_CIE peer;
+
+    if (A2D_ParsLdacInfo(&peer, p_peer_caps, TRUE) != A2D_SUCCESS)
+        return FALSE;
+    return (BOOLEAN)((peer.samp_freq & p_cap->samp_freq) &&
+                     (peer.ch_mode & p_cap->ch_mode));
+}
+
+/*******************************************************************************
+ **
+ ** Function         bta_av_build_aac_src_cfg / bta_av_build_ldac_src_cfg
+ **
+ ** Description      Build the preferred (single-value) configuration from the
+ **                  peer SRC capabilities for the INT (sink) side.
+ **
+ *******************************************************************************/
+static void bta_av_build_aac_src_cfg(UINT8 *p_pref_cfg, UINT8 *p_src_cap)
+{
+    tA2D_AAC_CIE src_cap;
+    tA2D_AAC_CIE pref;
+    const tA2D_AAC_CIE *p_sink_cap = &bta_av_co_aac_sink_caps;
+
+    memset(&pref, 0, sizeof(pref));
+    if (A2D_ParsAacInfo(&src_cap, p_src_cap, TRUE) != A2D_SUCCESS)
+    {
+        APPL_TRACE_ERROR("bta_av_build_aac_src_cfg: cannot parse peer caps");
+        return;
+    }
+
+    if (src_cap.obj_type & A2D_AAC_IE_OBJCT_MPEG2_LC)
+        pref.obj_type = A2D_AAC_IE_OBJCT_MPEG2_LC;
+    else if (src_cap.obj_type & A2D_AAC_IE_OBJCT_MPEG4_LC)
+        pref.obj_type = A2D_AAC_IE_OBJCT_MPEG4_LC;
+    else
+        return;
+
+    if ((src_cap.samp_freq & A2D_AAC_IE_SAMP_FREQ_48000) &&
+        (p_sink_cap->samp_freq & A2D_AAC_IE_SAMP_FREQ_48000))
+        pref.samp_freq = A2D_AAC_IE_SAMP_FREQ_48000;
+    else if ((src_cap.samp_freq & A2D_AAC_IE_SAMP_FREQ_44100) &&
+             (p_sink_cap->samp_freq & A2D_AAC_IE_SAMP_FREQ_44100))
+        pref.samp_freq = A2D_AAC_IE_SAMP_FREQ_44100;
+    else
+        return;
+
+    if ((src_cap.ch_mode & A2D_AAC_IE_CH_MD_STEREO) &&
+        (p_sink_cap->ch_mode & A2D_AAC_IE_CH_MD_STEREO))
+        pref.ch_mode = A2D_AAC_IE_CH_MD_STEREO;
+    else if ((src_cap.ch_mode & A2D_AAC_IE_CH_MD_MONO) &&
+             (p_sink_cap->ch_mode & A2D_AAC_IE_CH_MD_MONO))
+        pref.ch_mode = A2D_AAC_IE_CH_MD_MONO;
+    else
+        return;
+
+    pref.vbr = (src_cap.vbr && p_sink_cap->vbr) ? A2D_AAC_IE_VBR_ON
+                                                : A2D_AAC_IE_VBR_OFF;
+    pref.bitrate = src_cap.bitrate;
+    if (pref.bitrate == 0 || pref.bitrate > p_sink_cap->bitrate)
+        pref.bitrate = p_sink_cap->bitrate;
+
+    A2D_BldAacInfo(AVDT_MEDIA_AUDIO, &pref, p_pref_cfg);
+}
+
+static void bta_av_build_ldac_src_cfg(UINT8 *p_pref_cfg, UINT8 *p_src_cap)
+{
+    tA2D_LDAC_CIE src_cap;
+    tA2D_LDAC_CIE pref;
+    const tA2D_LDAC_CIE *p_sink_cap = &bta_av_co_ldac_sink_caps;
+
+    memset(&pref, 0, sizeof(pref));
+    if (A2D_ParsLdacInfo(&src_cap, p_src_cap, TRUE) != A2D_SUCCESS)
+    {
+        APPL_TRACE_ERROR("bta_av_build_ldac_src_cfg: cannot parse peer caps");
+        return;
+    }
+
+    if ((src_cap.samp_freq & A2D_LDAC_IE_SAMP_FREQ_48000) &&
+        (p_sink_cap->samp_freq & A2D_LDAC_IE_SAMP_FREQ_48000))
+        pref.samp_freq = A2D_LDAC_IE_SAMP_FREQ_48000;
+    else if ((src_cap.samp_freq & A2D_LDAC_IE_SAMP_FREQ_44100) &&
+             (p_sink_cap->samp_freq & A2D_LDAC_IE_SAMP_FREQ_44100))
+        pref.samp_freq = A2D_LDAC_IE_SAMP_FREQ_44100;
+    else if ((src_cap.samp_freq & A2D_LDAC_IE_SAMP_FREQ_96000) &&
+             (p_sink_cap->samp_freq & A2D_LDAC_IE_SAMP_FREQ_96000))
+        pref.samp_freq = A2D_LDAC_IE_SAMP_FREQ_96000;
+    else if ((src_cap.samp_freq & A2D_LDAC_IE_SAMP_FREQ_88200) &&
+             (p_sink_cap->samp_freq & A2D_LDAC_IE_SAMP_FREQ_88200))
+        pref.samp_freq = A2D_LDAC_IE_SAMP_FREQ_88200;
+    else
+        return;
+
+    if ((src_cap.ch_mode & A2D_LDAC_IE_CH_MD_STEREO) &&
+        (p_sink_cap->ch_mode & A2D_LDAC_IE_CH_MD_STEREO))
+        pref.ch_mode = A2D_LDAC_IE_CH_MD_STEREO;
+    else if ((src_cap.ch_mode & A2D_LDAC_IE_CH_MD_DUAL) &&
+             (p_sink_cap->ch_mode & A2D_LDAC_IE_CH_MD_DUAL))
+        pref.ch_mode = A2D_LDAC_IE_CH_MD_DUAL;
+    else if ((src_cap.ch_mode & A2D_LDAC_IE_CH_MD_MONO) &&
+             (p_sink_cap->ch_mode & A2D_LDAC_IE_CH_MD_MONO))
+        pref.ch_mode = A2D_LDAC_IE_CH_MD_MONO;
+    else
+        return;
+
+    pref.vendor_id = A2D_LDAC_VENDOR_ID;
+    pref.codec_id = A2D_LDAC_CODEC_ID;
+    A2D_BldLdacInfo(AVDT_MEDIA_AUDIO, &pref, p_pref_cfg);
+}
+
 /*******************************************************************************
  **
  ** Function         bta_av_build_src_cfg
@@ -387,12 +616,23 @@ void bta_av_co_audio_disc_res(tBTA_AV_HNDL hndl, UINT8 num_seps, UINT8 num_snk,
  ** Returns          Pass or Fail for current getconfig.
  **
  *******************************************************************************/
-void bta_av_build_src_cfg (UINT8 *p_pref_cfg, UINT8 *p_src_cap)
+void bta_av_build_src_cfg (UINT8 *p_pref_cfg, UINT8 *p_src_cap, UINT8 codec_type)
 {
     tA2D_SBC_CIE    src_cap;
     tA2D_SBC_CIE    pref_cap;
     UINT8           status = 0;
 
+    if (codec_type == A2D_MEDIA_CT_M24)
+    {
+        bta_av_build_aac_src_cfg(p_pref_cfg, p_src_cap);
+        return;
+    }
+    if (codec_type == A2D_MEDIA_CT_VEND)
+    {
+        bta_av_build_ldac_src_cfg(p_pref_cfg, p_src_cap);
+        return;
+    }
+
     /* initialize it to default SBC configuration */
     A2D_BldSbcInfo(AVDT_MEDIA_AUDIO, (tA2D_SBC_CIE *) &btif_av_sbc_default_config, p_pref_cfg);
     /* now try to build a preferred one */
@@ -491,9 +731,15 @@ UINT8 bta_av_audio_sink_getconfig(tBTA_AV_HNDL hndl, tBTA_AV_CODEC codec_type,
     switch (codec_type)
     {
         case BTA_AV_CODEC_SBC:
+        case A2D_MEDIA_CT_M24:
             supported = TRUE;
             break;
 
+        case A2D_MEDIA_CT_VEND:
+            /* Only accept the Sony LDAC vendor codec */
+            supported = bta_av_ldac_caps_is_ldac(p_codec_info);
+            break;
+
         default:
             break;
     }
@@ -542,7 +788,7 @@ UINT8 bta_av_audio_sink_getconfig(tBTA_AV_HNDL hndl, tBTA_AV_CODEC codec_type,
                 /* Save the new configuration */
                 p_peer->p_src = p_src;
                 /* get preferred config from src_caps */
-                bta_av_build_src_cfg(pref_cfg, p_src->codec_caps);
+                bta_av_build_src_cfg(pref_cfg, p_src->codec_caps, p_src->codec_type);
                 memcpy(p_peer->codec_cfg, pref_cfg, AVDT_CODEC_SIZE);
 
                 APPL_TRACE_DEBUG("bta_av_audio_sink_getconfig  p_codec_info[%x:%x:%x:%x:%x:%x]",
@@ -817,6 +1063,45 @@ void bta_av_co_audio_setconfig(tBTA_AV_HNDL hndl, tBTA_AV_CODEC codec_type,
             mutex_global_lock();
 
             /* Check if the configuration matches the current codec config */
+            if (AVDT_TSEP_SNK == t_local_sep)
+            {
+                /* Peer is SRC and proposes a config on one of our SINK SEPs.
+                 * bta_av_co_audio_sink_supports_config() above already
+                 * validated it against the caps we advertise: accept SBC,
+                 * AAC and LDAC as-is, no reconfiguration needed. */
+                switch (codec_type)
+                {
+                case BTA_AV_CODEC_SBC:
+                    APPL_TRACE_EVENT("remote peer setconfig bitpool range [%d:%d]",
+                       p_codec_info[BTA_AV_CO_SBC_MIN_BITPOOL_OFF], p_codec_info[BTA_AV_CO_SBC_MAX_BITPOOL_OFF] );
+                    bta_av_co_cb.codec_cfg_setconfig.id = BTIF_AV_CODEC_SBC;
+                    bta_av_co_cb.codec_cfg.id = BTIF_AV_CODEC_SBC;
+                    break;
+
+                case A2D_MEDIA_CT_M24:
+                    APPL_TRACE_EVENT("remote peer setconfig AAC");
+                    bta_av_co_cb.codec_cfg_setconfig.id = BTIF_AV_CODEC_AAC;
+                    bta_av_co_cb.codec_cfg.id = BTIF_AV_CODEC_AAC;
+                    break;
+
+                case A2D_MEDIA_CT_VEND:
+                    APPL_TRACE_EVENT("remote peer setconfig LDAC");
+                    bta_av_co_cb.codec_cfg_setconfig.id = BTIF_AV_CODEC_LDAC;
+                    bta_av_co_cb.codec_cfg.id = BTIF_AV_CODEC_LDAC;
+                    break;
+
+                default:
+                    APPL_TRACE_ERROR("bta_av_co_audio_setconfig unsupported codec type %d", codec_type);
