+ *  See the License for the specific language governing permissions and
+ *  limitations under the License.
+ *
+ ******************************************************************************/
+
+/******************************************************************************
+ *
+ *  Functions for the Sony LDAC A2DP vendor media codec (capability/config
+ *  element build + parse).
+ *
+ ******************************************************************************/
+
+#include "a2d_int.h"
+#include "a2d_ldac.h"
+#include "bt_utils.h"
+
+/******************************************************************************
+**
+** Function         A2D_BldLdacInfo
+**
+** Description      This function is called by an application to build
+**                  the LDAC Media Codec Capabilities byte sequence
+**                  beginning from the LOSC octet.
+**                  Input Parameters:
+**                      media_type:  Indicates Audio, or Multimedia.
+**
+**                      p_ie:  The LDAC Codec Information Element information.
+**
+**                  Output Parameters:
+**                      p_result:  the resulting codec info byte sequence.
+**
+** Returns          A2D_SUCCESS if function execution succeeded.
+**                  Error status code, otherwise.
+******************************************************************************/
+tA2D_STATUS A2D_BldLdacInfo(UINT8 media_type, tA2D_LDAC_CIE *p_ie, UINT8 *p_result)
+{
+    tA2D_STATUS status;
+    int i;
+
+    if (p_ie == NULL || p_result == NULL ||
+        (p_ie->vendor_id != A2D_LDAC_VENDOR_ID) ||
+        (p_ie->codec_id != A2D_LDAC_CODEC_ID) ||
+        (p_ie->samp_freq & ~A2D_LDAC_IE_SAMP_FREQ_MSK) ||
+        (p_ie->ch_mode & ~A2D_LDAC_IE_CH_MD_MSK))
+    {
+        /* if any unused bit is set */
+        status = A2D_INVALID_PARAMS;
+    }
+    else
+    {
+        status = A2D_SUCCESS;
+        *p_result++ = A2D_LDAC_INFO_LEN;
+        *p_result++ = media_type;
+        *p_result++ = A2D_MEDIA_CT_VEND;
+
+        /* Vendor ID (little endian) */
+        UINT8_TO_STREAM(p_result, (UINT8)(A2D_LDAC_VENDOR_ID & 0xFF));
+        UINT8_TO_STREAM(p_result, (UINT8)(A2D_LDAC_VENDOR_ID >> 8));
+        /* Codec ID (little endian) */
+        UINT8_TO_STREAM(p_result, (UINT8)(A2D_LDAC_CODEC_ID & 0xFF));
+        UINT8_TO_STREAM(p_result, (UINT8)(A2D_LDAC_CODEC_ID >> 8));
+
+        /* Media Codec Specific Information Element */
+        *p_result++ = p_ie->samp_freq;
+        *p_result++ = p_ie->ch_mode;
+
+        /* Reserved */
+        for (i = 0; i < 4; i++)
+            *p_result++ = 0;
+    }
+    return status;
+}
+
+/******************************************************************************
+**
+** Function         A2D_ParsLdacInfo
+**
+** Description      This function is called by an application to parse
+**                  the LDAC Media Codec Capabilities byte sequence
+**                  beginning from the LOSC octet.
+**                  Input Parameters:
+**                      p_info:  the byte sequence to parse.
+**
+**                      for_caps:  TRUE, if the byte sequence is for get
+**                                 capabilities response.
+**
+**                  Output Parameters:
+**                      p_ie:  The LDAC Codec Information Element information.
+**
+** Returns          A2D_SUCCESS if function execution succeeded.
+**                  Error status code, otherwise.
+******************************************************************************/
+tA2D_STATUS A2D_ParsLdacInfo(tA2D_LDAC_CIE *p_ie, const UINT8 *p_info,
+                             BOOLEAN for_caps)
+{
+    tA2D_STATUS status = A2D_SUCCESS;
+    UINT8 losc;
+
+    if (p_ie == NULL || p_info == NULL)
+        return A2D_INVALID_PARAMS;
+
+    losc = *p_info;
+    p_info += 2;
+
+    /* If the function is called for the wrong Media Type or Media Codec Type */
+    if (losc != A2D_LDAC_INFO_LEN || *p_info != A2D_MEDIA_CT_VEND)
+        return A2D_WRONG_CODEC;
+
+    p_info++;
+    /* Vendor ID (little endian) */
+    p_ie->vendor_id = (UINT16)(*p_info++);
+    p_ie->vendor_id |= (UINT16)(*p_info++) << 8;
+    /* Codec ID (little endian) */
+    p_ie->codec_id = (UINT16)(*p_info++);
+    p_ie->codec_id |= (UINT16)(*p_info++) << 8;
+
+    if (p_ie->vendor_id != A2D_LDAC_VENDOR_ID ||
+        p_ie->codec_id != A2D_LDAC_CODEC_ID)
+        return A2D_WRONG_CODEC;
+
+    p_ie->samp_freq = *p_info++ & A2D_LDAC_IE_SAMP_FREQ_MSK;
+    p_ie->ch_mode   = *p_info & A2D_LDAC_IE_CH_MD_MSK;
+
+    if (for_caps != FALSE)
+        return status;
+
+    /* Configuration: exactly one sampling frequency and channel mode */
+    if (A2D_BitsSet(p_ie->samp_freq) != A2D_SET_ONE_BIT)
+        status = A2D_BAD_SAMP_FREQ;
+    if (A2D_BitsSet(p_ie->ch_mode) != A2D_SET_ONE_BIT)
+        status = A2D_BAD_CH_MODE;
+
+    return status;
+}
