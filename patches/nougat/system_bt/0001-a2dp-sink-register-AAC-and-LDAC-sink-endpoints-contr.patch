+/******************************************************************************
+ *
+ *  Interface to the Sony LDAC vendor audio codec (A2DP vendor codec type,
+ *  Vendor ID 0x012D, Codec ID 0x00AA).  Byte layout follows Sony's LDAC
+ *  A2DP vendor codec specification.
+ *
+ ******************************************************************************/
+#ifndef A2D_LDAC_H
+#define A2D_LDAC_H
+
+#include "a2d_api.h"
+
+/*****************************************************************************
+**  Constants
+*****************************************************************************/
+/* Vendor media codec type (non-A2DP standard).  r36 has no definition. */
+#ifndef A2D_MEDIA_CT_VEND
+#define A2D_MEDIA_CT_VEND       0xFF
+#endif
+
+/* Length of the LDAC Media Codec Information Element (octets after LOSC):
+ * vendor id (2) + codec id (2) + sampling freq (1) + channel mode (1)
+ * + reserved (4). */
+#define A2D_LDAC_INFO_LEN       10
+
+/* Length of the LDAC Media Payload header (1 octet: F|S|L|num_frames). */
+#define A2D_LDAC_MPL_HDR_LEN    1
+
+/* Vendor and codec identifiers (little endian on the wire) */
+#define A2D_LDAC_VENDOR_ID      0x012D
+#define A2D_LDAC_CODEC_ID       0x00AA
+
+/* [Octet 4] Sampling frequency */
+#define A2D_LDAC_IE_SAMP_FREQ_MSK   0x3F
+#define A2D_LDAC_IE_SAMP_FREQ_44100 0x20
+#define A2D_LDAC_IE_SAMP_FREQ_48000 0x10
+#define A2D_LDAC_IE_SAMP_FREQ_88200 0x08
+#define A2D_LDAC_IE_SAMP_FREQ_96000 0x04
+#define A2D_LDAC_IE_SAMP_FREQ_176400 0x02
+#define A2D_LDAC_IE_SAMP_FREQ_192000 0x01
+
+/* [Octet 5] Channel mode */
+#define A2D_LDAC_IE_CH_MD_MSK       0x07
+#define A2D_LDAC_IE_CH_MD_MONO      0x04
+#define A2D_LDAC_IE_CH_MD_DUAL      0x02
+#define A2D_LDAC_IE_CH_MD_STEREO    0x01
+
+/* Media payload header bits (octet 0 of the RTP media payload) */
+#define A2D_LDAC_HDR_F_MSK          0x80    /* fragment */
+#define A2D_LDAC_HDR_S_MSK          0x40    /* start frame */
+#define A2D_LDAC_HDR_L_MSK          0x20    /* last frame */
+#define A2D_LDAC_HDR_NUM_MSK        0x0F    /* number of LDAC frames */
+
+/*****************************************************************************
+**  Type definitions
+*****************************************************************************/
+typedef struct
+{
+    UINT16  vendor_id;  /* Must be A2D_LDAC_VENDOR_ID */
+    UINT16  codec_id;   /* Must be A2D_LDAC_CODEC_ID */
+    UINT8   samp_freq;  /* Sampling frequency bit mask */
+    UINT8   ch_mode;    /* Channel mode bit mask */
+} tA2D_LDAC_CIE;
+
+/*****************************************************************************
+**  External Function Declarations
+*****************************************************************************/
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+/* Builds the LDAC Media Codec Capability/Configuration byte sequence
+ * beginning from the LOSC octet. */
+extern tA2D_STATUS A2D_BldLdacInfo(UINT8 media_type, tA2D_LDAC_CIE *p_ie,
+                                   UINT8 *p_result);
+
+/* Parses the LDAC Media Codec Capability byte sequence beginning from the
+ * LOSC octet. for_caps == TRUE relaxes the single-bit checks. */
+extern tA2D_STATUS A2D_ParsLdacInfo(tA2D_LDAC_CIE *p_ie, const UINT8 *p_info,
+                                    BOOLEAN for_caps);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* A2D_LDAC_H */
