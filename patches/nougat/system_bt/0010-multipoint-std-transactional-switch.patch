+/*******************************************************************************
+ **
+ ** Function         btif_media_task_sink_switch_req
+ **
+ ** Description      Multipoint: request a TRANSACTIONAL switch of the shared
+ **                  sink media path (decode pump + AudioTrack + decoders) to
+ **                  the codec configuration carried in the message.  The media
+ **                  worker executes stop-decoding, queue flush, track/decoder
+ **                  teardown and rebuild as ONE handler, so the enqueue side
+ **                  (BTU thread, delayed-start trigger) can never observe the
+ **                  half-torn-down state that the legacy CLEAR_TRACK +
+ **                  CFG_UPDATE two-message sequence exposed.  Mirrors the
+ **                  Android 11 btif_a2dp_sink_restart_session() design.
+ **
+ ** Returns          void
+ **
+ *******************************************************************************/
+void btif_media_task_sink_switch_req(UINT8 *codec_info)
+{
+    tBTIF_MEDIA_SINK_CFG_UPDATE *p_buf =
+        osi_malloc(sizeof(tBTIF_MEDIA_SINK_CFG_UPDATE));
+
+    APPL_TRACE_EVENT("btif_media_task_sink_switch_req codec[%x:%x:%x]",
+            codec_info[1], codec_info[2], codec_info[3]);
+
+    memcpy(p_buf->codec_info, codec_info, AVDT_CODEC_SIZE);
+    p_buf->hdr.event = BTIF_MEDIA_AUDIO_SINK_SWITCH;
+
+    fixed_queue_enqueue(btif_media_cmd_msg_queue, p_buf);
+}
