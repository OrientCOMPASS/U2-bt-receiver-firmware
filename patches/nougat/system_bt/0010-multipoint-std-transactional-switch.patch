+/* Multipoint (Patch 0010): transactional switch of the shared sink media
+ * path to the given codec configuration - executed as ONE media-worker
+ * message (stop pump + flush + teardown + rebuild) so the BTU-thread
+ * enqueue path never sees a half-torn-down state. */
+void btif_media_task_sink_switch_req(UINT8 *codec_info);
