diff --git a/btif/src/btif_av.c b/btif/src/btif_av.c
index 3889b5d..dc3e456 100644
--- a/btif/src/btif_av.c
+++ b/btif/src/btif_av.c
@@ -167,6 +167,49 @@ static int btif_av_slot_by_rc_handle(UINT8 rc_handle)
     return -1;
 }
 
+/* Patch 0010 (D9): BTA_AvClose/BTA_AvOpenRc/BTA_AvCloseRc must target the
+ * scb that actually holds THIS peer's AVDTP stream.  With multipoint the
+ * streaming scb is allocated at connection time and its hndl differs from
+ * the BTA_AvRegister hndl stored in the slot (proven by the 0009 field
+ * logs), so Java-initiated disconnect / RC open / RC close with the
+ * register hndl hit an unrelated (often idle) scb and silently failed.
+ * Prefer the runtime binding, fall back to the register hndl. */
+static UINT16 btif_av_runtime_hndl(void)
+{
+    if (g_slot_hndl[g_ctx_index] != 0)
+        return g_slot_hndl[g_ctx_index];
+    return btif_av_cb.bta_handle;
+}
+
+/* Patch 0010 (standard preemption policy, cf. Android 10
+ * A2dpSinkStreamHandler.onLossAudioFocus -> AVRCP PAUSE, and commercial
+ * multipoint receivers): AVDTP SUSPEND alone leaves the preempted phone's
+ * player in "playing" state - many players auto-reSTART, ping-ponging the
+ * shared media path between the two peers (switch war) and repeatedly
+ * re-opening the race window this patch closes.  Sending PASS THROUGH
+ * PAUSE over the preempted peer's own RC channel makes its player stop
+ * for good.  Press+release with fresh labels mimics a real key tap. */
+static void btif_av_send_avrcp_pause(int slot)
+{
+    static UINT8 s_pause_label = 0;
+    UINT8 rc_handle;
+    UINT8 label;
+
+    if (slot < 0 || slot >= BTIF_AV_NUM_SLOTS || g_slot_rc_handle[slot] == 0)
+    {
+        BTIF_TRACE_WARNING("MP: no RC channel for slot %d - cannot PAUSE preempted peer",
+                           slot);
+        return;
+    }
+    rc_handle = (UINT8)(g_slot_rc_handle[slot] - 1);
+    label = s_pause_label = (UINT8)((s_pause_label + 1) & 0x0F);
+    BTIF_TRACE_EVENT("MP: AVRCP PAUSE -> preempted slot %d (rc_handle %d, label %d)",
+                     slot, rc_handle, label);
+    BTA_AvRemoteCmd(rc_handle, label, BTA_AV_RC_PAUSE, BTA_AV_STATE_PRESS);
+    s_pause_label = (UINT8)((s_pause_label + 1) & 0x0F);
+    BTA_AvRemoteCmd(rc_handle, s_pause_label, BTA_AV_RC_PAUSE, BTA_AV_STATE_RELEASE);
+}
+
 static int btif_av_first_free_slot(void)
 {
     int i;
@@ -204,10 +247,16 @@ static void btif_av_media_switch_to_slot(int slot)
     BTIF_TRACE_EVENT("MP: media switch to slot %d (was %d)", slot, audio_active_slot);
     /* claim ownership first so it always matches bta_av_cb.p_active_scb */
     audio_active_slot = slot;
-    /* tear down the old decoder/AudioTrack first (reset_decoder would leak
-     * the previous track), then rebuild from the new peer's codec config */
-    btif_media_task_clear_track();
-    btif_reset_decoder(g_slot_cfg[slot]);
+    /* Patch 0010 (D1): ONE transactional SWITCH message (stop pump + flush
+     * queue + tear down track/decoders + rebuild from the new peer's codec
+     * cfg), mirroring android11 btif_a2dp_sink_restart_session().  The
+     * legacy CLEAR_TRACK + CFG_UPDATE two-message pair left a window in
+     * which the BTU-thread enqueue path (delayed start at 5 frames) could
+     * run start_decoding on a NULL track or a half-rebuilt decoder ->
+     * dead pump -> permanent silence. */
+    btif_media_task_sink_switch_req(g_slot_cfg[slot]);
+    /* blocks on sink_media_lock until the media worker finished the switch,
+     * so no frame can be enqueued before the new track/decoder exist */
     btif_a2dp_set_rx_flush(FALSE);
 }
 
