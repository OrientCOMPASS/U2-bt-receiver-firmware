@@ -634,6 +634,12 @@ void bta_av_stream_data_cback(UINT8 handle, BT_HDR *p_pkt, UINT32 time_stamp, UI
     for(index = 0; index < BTA_AV_NUM_STRS;index ++ )
     {
         p_scb = bta_av_cb.p_scb[index];
+        /* Patch 0010 (D5): unassigned p_scb[] entries are NULL - the old
+         * unconditional dereference crashed on any media packet whose
+         * avdt_handle matched no allocated stream (reachable since the
+         * multipoint expansion raised the stream count). */
+        if (p_scb == NULL)
+            continue;
