+//
+// Interface to the A2DP AAC Decoder.
+//
+// Backported from Android 9 (pie) to AOSP 8.1 for the KeenPlus U2 sink.
+// Two deliberate deviations from the pie original, because 8.1 differs:
+//   1. decoded_data_callback_t is defined here (8.1's a2dp_codec_api.h does not
+//      declare it; pie introduced it together with the decoder interface).
+//   2. a2dp_aac_decoder_decode_packet() takes a (data, len) pair instead of a
+//      BT_HDR*, because 8.1's btif_a2dp_sink queues media in its own
+//      tBT_SBC_HDR structure whose payload is not a BT_HDR flexible array.
+//
+
+#ifndef A2DP_AAC_DECODER_H
+#define A2DP_AAC_DECODER_H
+
+#include <stdint.h>
+
+// Callback invoked with decoded PCM. |buf| holds |len| bytes of 16-bit PCM.
+typedef void (*decoded_data_callback_t)(uint8_t* buf, uint32_t len);
+
+// Loads the A2DP AAC decoder.
+// Return true on success, otherwise false.
+bool A2DP_LoadDecoderAac(void);
+
+// Unloads the A2DP AAC decoder.
+void A2DP_UnloadDecoderAac(void);
+
+// Initialize the A2DP AAC decoder.
+bool a2dp_aac_decoder_init(decoded_data_callback_t decode_callback);
+
+// Cleanup the A2DP AAC decoder.
+void a2dp_aac_decoder_cleanup(void);
+
+// Decodes the AAC payload at |p_data| (|len| bytes).  Calls |decode_callback|
+// passed into |a2dp_aac_decoder_init| for each decoded PCM frame.
+bool a2dp_aac_decoder_decode_packet(uint8_t* p_data, uint16_t len);
+
+#endif  // A2DP_AAC_DECODER_H
