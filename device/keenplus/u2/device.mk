# device.mk -- KeenPlus U2 packages, blobs, copy-files and board properties.
#
# Package list is a WHITELIST (plan section 15.1): everything not listed here is
# simply not installed.  Telephony/SMS/SIM/modem, camera, NFC, print, and all MTK
# bloat (MiraVision, EngineerMode, MTKLogger, Exchange2, MtkCalendar, Omacp,
# AtciService, MDMLSample, LocationEM2, YGPS, FTPreCheck, BsHotApps) and the
# /preload hotapps are intentionally absent.

# --------------------------------------------------------------------------- #
# Kept AOSP packages (minimal daily-use set)
# --------------------------------------------------------------------------- #
PRODUCT_PACKAGES += \
    Settings \
    SystemUI \
    Launcher3 \
    PackageInstaller \
    DocumentsUI \
    SettingsProvider \
    MediaProvider \
    DownloadProvider \
    Bluetooth \
    Jelly \
    Music \
    FileManager \
    DeskClock \
    LatinIME

# Audio/media framework pieces required for the A2DP sink + local playback.
# libtinyalsa: the MTK audio.primary blob DT_NEEDEDs libtinyalsa.so but the
# baseline copy is NOT shipped (module-name collision with external/tinyalsa,
# and AOSP's copy is installed for libbootanimation anyway); the AOSP 8.1
# build provides the classic tinyalsa C ABI the MTK HAL links against.
# Listed explicitly so it is installed even if bootanimation is ever dropped.
PRODUCT_PACKAGES += \
    audio.a2dp.default \
    audio.r_submix.default \
    audio.usb.default \
    libaudioclient \
    libmedia \
    libtinyalsa \
    tinymix \
    tinyplay

# --------------------------------------------------------------------------- #
# MTK platform blobs + wmt tools.  The .so/bin blobs are extracted into
# vendor/keenplus/u2/proprietary by device/keenplus/u2/extract-files.sh (see
# proprietary-files.txt).  Their prebuilt module definitions live in
# vendor/keenplus/u2/Android.mk, and the matching PRODUCT_PACKAGES list in
# vendor/keenplus/u2/blobs.mk -- BOTH generated by scripts/gen-vendor-mk.py so
# they can never drift from proprietary-files.txt (CI enforces this with
# `gen-vendor-mk.py --check`).  Including blobs.mk here keeps this file the
# single entry point for what the product installs.
# --------------------------------------------------------------------------- #
include vendor/keenplus/u2/blobs.mk

# --------------------------------------------------------------------------- #
# Bluetooth configuration (plan section 16)
# --------------------------------------------------------------------------- #
# A2DP Sink + AVRCP Controller are enabled through the resource overlay in
# overlay/packages/apps/Bluetooth/res/values/config.xml and the compile-time
# switches in bdroid_buildcfg.h.  Runtime stack config:
PRODUCT_COPY_FILES += \
    device/keenplus/u2/bluetooth/bt_stack.conf:system/etc/bluetooth/bt_stack.conf \
    device/keenplus/u2/bluetooth/bt_did.conf:system/etc/bluetooth/bt_did.conf

# --------------------------------------------------------------------------- #
# Audio policy: the A2DP input profile must accept 44100|48000 so an AAC sink
# negotiated at 48 kHz is not resampled/rejected (plan sections 2.2 and 16.4).
# --------------------------------------------------------------------------- #
PRODUCT_COPY_FILES += \
    device/keenplus/u2/audio/a2dp_audio_policy_configuration.xml:system/etc/a2dp_audio_policy_configuration.xml

# --------------------------------------------------------------------------- #
# Ramdisk / init files (plan section 14.3)
# --------------------------------------------------------------------------- #
PRODUCT_COPY_FILES += \
    device/keenplus/u2/rootdir/fstab.mt6735:root/fstab.mt6735 \
    device/keenplus/u2/rootdir/init.zygote32.rc:root/init.zygote32.rc \
    device/keenplus/u2/rootdir/enableswap.sh:root/enableswap.sh

# --------------------------------------------------------------------------- #
# Firmware (MT6627 BT/Wi-Fi/FM).  Installed to /vendor/firmware (i.e.
# system/vendor/firmware on this non-Treble build) because the baseline
# starts wmt_launcher with `-p /vendor/firmware/`.  Modem/DSP/catcher images
# are NOT copied (non-goal, plan section 9).
# --------------------------------------------------------------------------- #
PRODUCT_COPY_FILES += \
    vendor/keenplus/u2/proprietary/vendor/firmware/ROMv2_lm_patch_1_0_hdr.bin:vendor/firmware/ROMv2_lm_patch_1_0_hdr.bin \
    vendor/keenplus/u2/proprietary/vendor/firmware/ROMv2_lm_patch_1_1_hdr.bin:vendor/firmware/ROMv2_lm_patch_1_1_hdr.bin \
    vendor/keenplus/u2/proprietary/vendor/firmware/WMT_SOC.cfg:vendor/firmware/WMT_SOC.cfg \
    vendor/keenplus/u2/proprietary/vendor/firmware/WIFI_RAM_CODE_6735:vendor/firmware/WIFI_RAM_CODE_6735 \
    vendor/keenplus/u2/proprietary/vendor/firmware/mt6627_fm_v1_coeff.bin:vendor/firmware/mt6627_fm_v1_coeff.bin \
    vendor/keenplus/u2/proprietary/vendor/firmware/mt6627_fm_v1_patch.bin:vendor/firmware/mt6627_fm_v1_patch.bin

# --------------------------------------------------------------------------- #
# 64-bit runtime shim (decision D2, corrected): the baseline product is
# arm64 (ro.product.cpu.abi=arm64-v8a) and wmt_loader / wmt_launcher /
# stp_dump3 are AArch64.  u2 stays 32-bit, but the arm64 kernel runs both,
# so the baseline 7.0 linker64 + the exact lib64 closure of those tools is
# installed verbatim.  The 32-bit framework never loads these files.
# --------------------------------------------------------------------------- #
PRODUCT_COPY_FILES += \
    vendor/keenplus/u2/proprietary/bin/linker64:system/bin/linker64 \
    vendor/keenplus/u2/proprietary/lib64/libc.so:system/lib64/libc.so \
    vendor/keenplus/u2/proprietary/lib64/libm.so:system/lib64/libm.so \
    vendor/keenplus/u2/proprietary/lib64/libdl.so:system/lib64/libdl.so \
    vendor/keenplus/u2/proprietary/lib64/liblog.so:system/lib64/liblog.so \
    vendor/keenplus/u2/proprietary/lib64/libc++.so:system/lib64/libc++.so \
    vendor/keenplus/u2/proprietary/lib64/libcutils.so:system/lib64/libcutils.so

# --------------------------------------------------------------------------- #
# MTK vendor services (WMT firmware download for BT, nvram, fuel gauge).
# Placed in /system/etc/init/ where 8.1 init auto-imports it.
# --------------------------------------------------------------------------- #
PRODUCT_COPY_FILES += \
    device/keenplus/u2/rootdir/init.u2.connectivity.rc:system/etc/init/init.u2.connectivity.rc

# --------------------------------------------------------------------------- #
# MTK configuration data extracted alongside the blobs.
# audio_device.xml / audio_param/ are read by the MTK audio.primary HAL;
# .tp holds the touch-panel tuning (wildcard-expanded at parse time -- the
# extraction step runs before kati, so the files are present).
# --------------------------------------------------------------------------- #
PRODUCT_COPY_FILES += \
    vendor/keenplus/u2/proprietary/vendor/etc/audio_device.xml:vendor/etc/audio_device.xml \
    vendor/keenplus/u2/proprietary/vendor/lib/egl/egl.cfg:vendor/lib/egl/egl.cfg \
    vendor/keenplus/u2/proprietary/vendor/etc/audio_em.xml:vendor/etc/audio_em.xml \
    vendor/keenplus/u2/proprietary/etc/wifi/wpa_supplicant.conf:system/etc/wifi/wpa_supplicant.conf \
    vendor/keenplus/u2/proprietary/etc/wifi/p2p_supplicant_overlay.conf:system/etc/wifi/p2p_supplicant_overlay.conf \
    vendor/keenplus/u2/proprietary/etc/wifi/wpa_supplicant_overlay.conf:system/etc/wifi/wpa_supplicant_overlay.conf

U2_AUDIO_PARAM_FILES := $(wildcard vendor/keenplus/u2/proprietary/vendor/etc/audio_param/*)
PRODUCT_COPY_FILES += \
    $(foreach f,$(U2_AUDIO_PARAM_FILES),$(f):vendor/etc/audio_param/$(notdir $(f)))

U2_TP_FILES := $(wildcard vendor/keenplus/u2/proprietary/vendor/etc/.tp/*)
PRODUCT_COPY_FILES += \
    $(foreach f,$(U2_TP_FILES),$(f):vendor/etc/.tp/$(notdir $(f)))

# --------------------------------------------------------------------------- #
# Resource overlay (Bluetooth profile switches + framework config)
# --------------------------------------------------------------------------- #
DEVICE_PACKAGE_OVERLAYS += device/keenplus/u2/overlay

# --------------------------------------------------------------------------- #
# Misc board properties
# --------------------------------------------------------------------------- #
PRODUCT_PROPERTY_OVERRIDES += \
    ro.mount.fs=EXT4 \
    ro.mtkrc.path=/vendor/etc/init/hw/ \
    persist.sys.usb.config=mtp \
    ro.mediatek.chip_ver=S01 \
    ro.sys.sdcardfs=true

# Wi-Fi (MT6627, 2.4G b/g/n only)
PRODUCT_PROPERTY_OVERRIDES += \
    wifi.interface=wlan0 \
    ro.mediatek.wlan.wsc=1 \
    ro.mediatek.wlan.p2p=1

# FM
PRODUCT_PROPERTY_OVERRIDES += \
    ro.mtk_fm_support=1

# Graphics: 8.1's EGL loader selects libEGL_<ro.hardware.egl>.so (egl.cfg is
# ignored); the baseline relied on /vendor/lib/egl/egl.cfg ("0 1 mali").
# The mali DDK aliases are recreated as symlinks by device/keenplus/u2/Android.mk.
PRODUCT_PROPERTY_OVERRIDES += \
    ro.hardware.egl=mali \
    ro.opengles.version=196609

# Boot animation: replaced with a <=400 KiB custom clip (plan section 15.4).
# The baseline 4.42 MiB bootanimation.zip and the shutanimation.zip are dropped.
PRODUCT_PROPERTY_OVERRIDES += \
    debug.sf.nobootanimation=0
