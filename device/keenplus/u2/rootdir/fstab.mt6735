# Android fstab file -- KeenPlus U2 (MT6735M / tek6735m_65_d_n)
#
# Derived from the baseline ramdisk fstab.mt6735 with the two changes mandated by
# decision D5 (plan sections 2 and 14.3):
#   * /system : the ",verify" fs_mgr flag is REMOVED (dm-verity off).
#   * /data   : the ",forceencrypt=/dev/block/.../by-name/metadata" flag is
#               REMOVED (full-disk encryption off).  The 7.0 FDE structures are
#               incompatible with 8.1, so userdata MUST be erased/re-flashed.
#
# <src>                                                        <mnt_point>  <type>  <mnt_flags>                                   <fs_mgr_flags>

system    /system    ext4    ro                                                            wait
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/userdata    /data     ext4    noatime,nosuid,nodev,noauto_da_alloc,discard    wait,check,resize
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/cache       /cache    ext4    noatime,nosuid,nodev,noauto_da_alloc,discard    wait,check
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect1    /protect_f    ext4    noatime,nosuid,nodev,noauto_da_alloc,discard    wait,check
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/protect2    /protect_s    ext4    noatime,nosuid,nodev,noauto_da_alloc,discard    wait,check
/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/nvdata      /nvdata     ext4    noatime,nosuid,nodev,noauto_da_alloc,discard    wait,check

# Removable storage (TF card + USB OTG), as declared in the baseline DTB/fstab.
/devices/mtk-msdc.1/11240000.msdc1*    auto    vfat    defaults    voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/mt_usb*              auto    vfat    defaults    voldmanaged=usbotg:auto

# zram swap is configured by /enableswap.sh (see that file); declared here so
# fs_mgr knows about the swap target.
/dev/block/zram0    none    swap    defaults    zramsize=805306368,zramstreams=4
