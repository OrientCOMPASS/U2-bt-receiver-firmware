# file_contexts -- map filesystem paths to the SEPolicy types declared above.
#
# Regexes are matched by the build's file_contexts.bin generation; keep them
# anchored and use (/.*)? for directories.

# Platform device node (only present if the helper exposes one).
/dev/u2(/.*)?                       u:object_r:u2_device:s0

# The helper executable.
/system/bin/u2_btaudio              u:object_r:u2_btaudio_exec:s0

# Persistent cache: last-used A2DP device + negotiated codec.
/data/misc/u2_btaudio(/.*)?         u:object_r:u2_btaudio_data_file:s0

# Runtime scratch dir (recreated each boot).
/data/u2_btaudio_runtime(/.*)?      u:object_r:u2_btaudio_runtime_file:s0
